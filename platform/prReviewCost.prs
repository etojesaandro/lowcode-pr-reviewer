or="code" name="buttonContainerStyle" type="S"><editorOptions>scss</editorOptions><help>Applied if Zoom Type is set to Zoom Buttons. The CSS style to apply to the Zoom In and Zoom Out buttons.</help><defaultValue/></field><field description="Data Source Type" name="sourceType" type="S"><selectionValues><option description="Event">eventData</option><option description="Variable">variableData</option><option description="Source Data">sourceData</option></selectionValues><help>Defines what kind of data is used to build a chart: Variable, Event, or Custom Data.</help><defaultValue>sourceData</defaultValue></field><field description="Source Variables" name="variableData" type="T"><defaultValue><table><format/></table></defaultValue></field><field description="Source Events" name="eventData" type="T"><defaultValue><table><format/></table></defaultValue></field><field description="Include Historical Data" name="useHistoricalData" type="B"><help>Specifies whether the chart will include historical data loaded according to the Limit Time Range setting.</help><defaultValue>1</defaultValue></field><field description="Include Real-Time Data" name="useRealTimeData" type="B"><help>Specifies whether the chart will be dynamically updated with real-time data.</help><defaultValue>0</defaultValue></field><field description="Limit Time Range" name="limitTimeRange" type="S"><selectionValues><option description="Full History">fullHistory</option><option description="Last Values">lastValues</option><option description="Date Range">dateRange</option></selectionValues><help>Specifies the time range of historical data: Full History, Last Values, or Date Range.</help><defaultValue>fullHistory</defaultValue></field><field description="Time Range" editor="period" name="timeRange" type="L"><editorOptions>1</editorOptions><help>Specifies the maximum age of historical data to be used by the chart.</help><defaultValue>1000</defaultValue></field><field description="Start Date" name="startDate" nullable="true" type="D"><help>Low bound timestamp of the displayed historical values range. Applies when Limit Time Range is set to Date Range.</help><defaultValue>2026-10-22 05:35:15.834</defaultValue></field><field description="End Date" name="endDate" nullable="true" type="D"><help>High bound timestamp of the displayed historical values range. Applies when Limit Time Range is set to Date Range.</help><defaultValue>2026-10-22 06:35:15.834</defaultValue></field><field description="Aggregation Time Period" name="aggregateTimePeriod" type="S"><selectionValues><option description="Millisecond">millisecond</option><option description="Second">second</option><option description="Minute">minute</option><option description="Hour">hour</option><option description="Day">day</option><option description="Week">week</option><option description="Month">month</option><option description="Quarter">quarter</option><option description="Year">year</option></selectionValues><help>Time unit that defines the resolution for variable-based and event-based charts.</help><defaultValue>minute</defaultValue></field><field description="Axis Render Type" name="metricTypeX" type="S"><selectionValues><option description="auto">auto</option><option description="linear">linear</option><option description="log">log</option><option description="pow">pow</option><option description="time">time</option><option description="quantize">quantize</option><option description="quantile">quantile</option><option description="cat">cat</option><option description="timeCat">timeCat</option><option description="identity">identity</option></selectionValues><help>Options for scaling the X axis.</help><defaultValue>auto</defaultValue></field><field description="Tick Render Method" name="tickMethodX" type="S"><selectionValues><option description="auto">auto</option><option description="wilkinson-extended">wilkinson-extended</option><option description="r-pretty">r-pretty</option><option description="time">time</option><option description="time-pretty">time-pretty</option><option description="log">log</option><option description="pow">pow</option><option description="quantile">quantile</option></selectionValues><defaultValue>auto</defaultValue></field><field description="Axis Render Type" name="metricTypeY" type="S"><selectionValues><option description="auto">auto</option><option description="linear">linear</option><option description="log">log</option><option description="pow">pow</option><option description="time">time</option><option description="quantize">quantize</option><option description="quantile">quantile</option><option description="cat">cat</option><option description="timeCat">timeCat</option><option description="identity">identity</option></selectionValues><help>Options for scaling the vertical axis.</help><defaultValue>auto</defaultValue></field><field description="Tick Render Method" name="tickMethodY" type="S"><selectionValues><option description="auto">auto</option><option description="wilkinson-extended">wilkinson-extended</option><option description="r-pretty">r-pretty</option><option description="time">time</option><option description="time-pretty">time-pretty</option><option description="log">log</option><option description="pow">pow</option><option description="quantile">quantile</option></selectionValues><defaultValue>auto</defaultValue></field><field description="Tick Interval" name="tickIntervalX" nullable="true" type="I"><help>Sets the interval between ticks on the X-axis of a chart.</help><defaultValue><nullValue/></defaultValue></field><field description="Tick Interval" name="tickIntervalY" nullable="true" type="I"><help>Sets the interval between ticks on the Y-axis of a chart.</help><defaultValue><nullValue/></defaultValue></field><field description="Min Tick Interval" name="minTickIntervalX" nullable="true" type="I"><help>Specifies the minimum interval between ticks on the X-axis of a chart.</help><defaultValue><nullValue/></defaultValue></field><field description="Min Tick Interval" name="minTickIntervalY" nullable="true" type="I"><help>Specifies the minimum interval between ticks on the Y-axis of a chart.</help><defaultValue><nullValue/></defaultValue></field><field description="Max Tick Count" name="maxTickCountX" type="I"><help>Sets the maximum number of ticks displayed on the X-axis of a chart.</help><defaultValue>10</defaultValue></field><field description="Max Tick Count" name="maxTickCountY" type="I"><help>Sets the maximum number of ticks displayed on the Y-axis of a chart.</help><defaultValue>10</defaultValue></field><field description="Tick Count" name="tickCountX" type="I"><help>Specifies the desired number of ticks on the X-axis of a chart.</help><defaultValue>5</defaultValue></field><field description="Tick Count" name="tickCountY" type="I"><help>Specifies the desired number of ticks on the Y-axis of a chart.</help><defaultValue>5</defaultValue></field><field description="Tick Exponent" name="tickExponentX" type="I"><help>Sets the exponent for the tick interval on the X-axis, influencing the scale of tick values.</help><defaultValue>1</defaultValue></field><field description="Tick Exponent" name="tickExponentY" type="I"><help>Sets the exponent for the tick interval on the Y-axis, influencing the scale of tick values.</help><defaultValue>1</defaultValue></field><field description="Tick Log Base" name="tickLogBaseX" type="I"><help>Specifies the base of the logarithm for the axis scale. Applies only when Axis Render Type is set to Logarithmic.</help><defaultValue>5</defaultValue></field><field description="Tick Log Base" name="tickLogBaseY" type="I"><help>Specifies the base of the logarithm for the axis scale. Applies only when Axis Render Type is set to Logarithmic.</help><defaultValue>5</defaultValue></field><field description="Grid Line Show X" name="gridLineShowX" type="B"><help>Shows or hides the vertical grid lines corresponding to tick marks along the X axis.</help><defaultValue>1</defaultValue></