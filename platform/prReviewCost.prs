></selectionValues><help>Allows switching between graphical presentations of the button. Each button style can be modified using CSS-related properties.</help><defaultValue>main</defaultValue></field><field description="Size" name="size" type="S"><selectionValues><option description="Huge">huge</option><option description="Big">big</option><option description="Medium">medium</option><option description="Small">small</option></selectionValues><help>Size of the button.</help><defaultValue>medium</defaultValue></field><field description="Button Text Style" editor="code" name="textButtonContainerStyle" type="S"><editorOptions>scss</editorOptions><help>CSS style to be applied to the text of the button label.</help><defaultValue/></field><field description="Image Container" editor="code" name="imageButtonContainerStyle" type="S"><editorOptions>scss</editorOptions><help>CSS style to be applied to the container of the button image.</help><defaultValue/></field><field description="Content" editor="html" name="tooltipContent" type="S"><help>Text or HTML content to be displayed in the tooltip.</help><defaultValue/></field><field description="Placement" name="tooltipPlacement" type="S"><selectionValues><option description="Top">top</option><option description="Top Right">topRight</option><option description="Top Left">topLeft</option><option description="Right">right</option><option description="Right Top">rightTop</option><option description="Right Bottom">rightBottom</option><option description="Bottom">bottom</option><option description="Bottom Right">bottomRight</option><option description="Bottom Left">bottomLeft</option><option description="Left">left</option><option description="Left Top">leftTop</option><option description="Left Bottom">leftBottom</option></selectionValues><help>Position of the tooltip relative to the component.</help><defaultValue>top</defaultValue></field><field description="Color" name="tooltipColor" type="C"><help>Background color of the tooltip bubble.</help><defaultValue>#404040FF</defaultValue></field><field description="Mouse Enter Delay" editor="period" name="tooltipMouseEnterDelay" type="L"><editorOptions>0 1</editorOptions><help>Delay time before the tooltip appears when the mouse cursor enters the component.</help><defaultValue>100</defaultValue></field><field description="Mouse Leave Delay" editor="period" name="tooltipMouseLeaveDelay" type="L"><editorOptions>0 1</editorOptions><help>Delay time before the tooltip disappears after the mouse cursor leaves the component.</help><defaultValue>100</defaultValue></field><field description="Class Name" name="tooltipClassName" type="S"><help>CSS class to assign to the tooltip, allowing customization of the tooltip styling with CSS.</help><defaultValue/></field><field description="Style" editor="code" name="tooltipContentStyle" nullable="true" type="S"><editorOptions>scss</editorOptions><help>Additional CSS style or styles to be applied to the tooltip content.</help><defaultValue/></field></fields></format></entry><entry><int>42</int><format maxRecords="1" minRecords="1"><fields><field description="Type" name="imageType" type="I"><selectionValues><option description="Data Block">0</option><option description="URL">1</option></selectionValues><help>Defines whether the image is embedded into the dashboard as a binary data block or loaded from a URL.</help><defaultValue>0</defaultValue></field><field description="Image Data" name="imageData" type="A"><help>Embedded image data.</help><defaultValue><data><nullValue/></data></defaultValue></field><field description="Image URL" name="imageUrl" type="S"><help>Image URL. Can refer to a Media Library item or to any third party resource.</help><defaultValue/></field><field description="Embed SVG To DOM" name="embedSVGToDOM" type="B"><help>When enabled, an SVG image is embedded directly into the page DOM instead of being displayed as a separate image element.</help><defaultValue>0</defaultValue></field></fields><bindings><