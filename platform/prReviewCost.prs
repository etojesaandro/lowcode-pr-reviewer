tVerticalX" type="F"><help>Sets equal padding for the axis line from both the top and bottom edges.</help><defaultValue>0</defaultValue></field><field description="Line Offset Horizontal" name="axisLineOffsetHorizontalX" type="F"><help>Sets equal padding for the axis line from both the left and right edges.</help><defaultValue>0</defaultValue></field><field description="Show Tick" name="showXAxisTick" type="B"><help>Displays the tick marks on the axis.</help><defaultValue>1</defaultValue></field><field description="Tick Length" name="axisTickLengthX" type="F"><help>Specifies the length of the tick marks on the axis.</help><defaultValue>4</defaultValue></field><field description="Tick Width" name="axisTickLineWidthX" type="F"><help>Specifies the width of the tick marks on the axis.</help><defaultValue>1</defaultValue></field><field description="Tick Line Dash" name="axisTickLineDashX" type="S"><help>Specifies the dash pattern of the tick marks as two values: dash length and gap length (e.g., 1, 1).</help><defaultValue>0, 0</defaultValue></field><field description="Tick Color" name="axisTickColorX" type="C"><help>Sets the color of the tick marks on the axis.</help><defaultValue>#000000FF</defaultValue></field><field description="Tick Opacity" name="axisTickOpacityX" type="F"><validators contentType="base64">HEweMC4wIDEuMB0=</validators><help>Controls the transparency of the tick marks. Accepts a value between 0 (fully transparent) and 1 (fully opaque).</help><defaultValue>1</defaultValue></field><field description="Show Tick" name="showYAxisTick" type="B"><help>Displays the tick marks on the axis.</help><defaultValue>1</defaultValue></field><field description="Tick Length" name="axisTickLengthY" type="F"><help>Specifies the length of the tick marks on the axis.</help><defaultValue>4</defaultValue></field><field description="Tick Width" name="axisTickLineWidthY" type="F"><help>Specifies the width of the tick marks on the axis.</help><defaultValue>1</defaultValue></field><field description="Tick Line Dash" name="axisTickLineDashY" type="S"><help>Specifies the dash pattern of the tick marks as two values: dash length and gap length (e.g., 1, 1).</help><defaultValue>0, 0</defaultValue></field><field description="Tick Color" name="axisTickColorY" type="C"><help>Sets the color of the tick marks on the axis.</help><defaultValue>#000000FF</defaultValue></field><field description="Tick Opacity" name="axisTickOpacityY" type="F"><validators contentType="base64">HEweMC4wIDEuMB0=</validators><help>Controls the transparency of the tick marks. Accepts a value between 0 (fully transparent) and 1 (fully opaque).</help><defaultValue>1</defaultValue></field><field description="Render as Group" name="renderAsGroup" type="B"><help>Group data into sub-columns according to the value of the Group and Series fields of the source data.</help><defaultValue>0</defaultValue></field><field description="Column Width Ratio" name="columnWidthRatio" nullable="true" type="F"><validators contentType="base64">HEweMC4wIDEuMB0=</validators><help>Indicates the ratio of columns to spacing between columns as a value between 0 and 1.</help><defaultValue>0.7</defaultValue></field><field description="Series Style" name="styleSeriesStyleBar" type="T"><defaultValue><table><format/></table></defaultValue></field><field description="Fill" name="styleFillBar" nullable="true" type="C"><help>Defines the fill color of the bars in the chart.</help><defaultValue><nullValue/></defaultValue></field><field description="Fill Opacity" name="styleFillOpacityBar" nullable="true" type="F"><validators contentType="base64">HEweMC4wIDEuMB0=</validators><help>Controls the opacity level of the fill color for the bars in the chart.</help><defaultValue><nullValue/></defaultValue></field><field description="Border Color" name="styleStrokeBar" nullable="true" type="C"><help>Sets the border color of the bars in the chart.</help><defaultValue><nullValue/></defaultValue></field><field description="Border Opacity" name="styleStrokeOpacityBar" nullable="true" type="F"><validators contentType="base64">HEweMC4wIDEuMB0=</validators><help>Controls the opacity of the border color of the bars in the chart.</help><defaultValue><nullValue/></defaultValue></field><field description="Inset Left" name="styleInsetLeftBar" type="F"><help>Sets the left margin of each bar, controlling spacing between adjacent bars.</help><defaultValue>0</defaultValue></field><field description="Inset Right" name="styleInsetRightBar" type="F"><help>Sets the right margin of each bar, controlling spacing between adjacent bars.</help><defaultValue>0</defaultValue></field><field description="Inset Top" name="styleInsetTopBar" type="F"><help>Sets the top margin of each bar, controlling spacing between the bar top and the chart area.</help><defaultValue>0</defaultValue></field><field description="Inset Bottom" name="styleInsetBottomBar" type="F"><help>Sets the bottom margin of each bar, controlling spacing between the bar and the chart baseline.</help><defaultValue>0</defaultValue></field><field description="Border Width" name="styleLineWidthBar" nullable="true" type="I"><help>Determines the width of the border of the bars in the chart.</help><defaultValue><nullValue/></defaultValue></field><field description="Border Dash Interval" name="styleLineDashBar" nullable="true" type="S"><help>Specifies the dash pattern of the border of the bars in the chart.</help><defaultValue><nullValue/></defaultValue></field><field description="Shadow Color" name="styleShadowColorBar" nullable="true" type="C"><help>Sets the color of the shadow cast by the bars in the chart.</help><defaultValue><nullValue/></defaultValue></field><field description="Shadow Blur" name="styleShadowBlurBar" nullable="true" type="I"><help>Determines the blurring effect applied to the shadow cast by the bars in the chart.</help><defaultValue><nullValue/></defaultValue></field><field description="Shadow Offset X" name="styleShadowOffsetXBar" nullable="true" type="I"><help>Controls the horizontal offset of the shadow cast by the bars in the chart.</help><defaultValue><nullValue/></defaultValue></field><field description="Shadow Offset Y" name="styleShadowOffsetYBar" nullable="true" type="I"><help>Controls the vertical offset of the shadow cast by the bars in the chart.</help><defaultValue><nullValue/></defaultValue></field><field description="Cursor" name="styleCursorBar" nullable="true" type="S"><selectionValues><option description="Default">default</option><option description="Pointer">pointer</option><option description="Help">help</option><option description="Progress">progress</option><option description="Wait">wait</option><option description="None">none</option></selectionValues><help>Defines the cursor appearance when interacting with the bars in the chart.</help><defaultValue><nullValue/></defaultValue></field><field description="Multiple Axis" name="multipleAxis" type="T"><defaultValue><table><format/></table></defaultValue></field></fields></format></entry><entry><int>3</int><format><fields><field description="Variable" keyfield="true" name="variable" type="S"><help>Name of the UI component variable to be stored.</help><defaultValue/></field><field description="Storage Type" name="layoutStorage" type="S"><selectionValues><option description="Shared">shared</option><option description="For Every User">forEveryUser</option><option description="For Every Login">forEveryLogin</option></selectionValues><help>&lt;p>Options for how the variable should be saved:&lt;/p>&lt;ul>&lt;li>&lt;b>For Every Login&lt;/b> — save the variable for each login session of each user. Variable will be discarded when the user logs out.&lt;/li>&lt;li>&lt;b>For Every User&lt;/b> — save the variable for each user and persist variable values between sessions.&lt;/li>&lt;li>&lt;b>Shared&lt;/b> — save a single value of the variable for all users and persist the value between sessions.&lt;/li>&lt;/ul></help><defaultValue>shared</defaultValue></field></fields><bindings><binding><reference>variable#choices</reference><expression>{.:variableSelection()}</expression></binding></bindings><validators contentType="base64">HEseHQ==</validators></format></entry><entry><int>4</int><format><fields><field description="Breakpoint" name="breakpoint" nullable="true" type="S"><help>Name of the breakpoint at that the properties are applied.</help><defaultValue>default</defaultValue></field><field description="Style" name="style" nullable="true" type="S"><help>A compiled string of Custom Classes and Component Content Style to be applied at the breakpoint.</help><defaultValue/></field><field description="Wrapper Style" name="containerStyle" type="S"><editorOptions>textarea</editorOptions><help>A compiled string of Wrapper Style, Content Overflow, and some other component properties to be applied at the breakpoint.</help><defaultValue/></field></fields></format></entry><entry><int>5</int><format><fields><field description="Item Name" name="name" type="S"><help>Unique identifier of the context menu item.</help><defaultValue/></field><field description="Item Description" name="description" nullable="true" type="S"><help>Text displayed for the menu item.</help><defaultValue><nullValue/></defaultValue></field><field description="Item Icon" name="icon" nullable="true" type="T"><help>Icon displayed next to the menu item.</help><defaultValue><table><format maxRecords="1" minRecords="1"><fields><field description="Type" name="imageType" type="I"><selectionValues><option description="Data Block">0</option><option description="URL">1</option></selectionValues><help>Defines whether the image is embedded into the dashboard as a binary data block or loaded from a URL.</help><defaultValue>0</defaultValue></field><field description="Image Data" name="imageData" type="A"><help>Embedded image data.</help><defaultValue><data><nullValue/></data></defaultValue></field><field description="Image URL" name="imageUrl" type="S"><help>Image URL. Can refer to a Media Library item or to any third party resource.</help><defaultValue/></field></fields><bindings><binding><reference>imageData#enabled</reference><expression>{imageType} == 0</expression></binding><binding><reference>imageUrl#enabled</reference><expression>{imageType} == 1</expression></binding></bindings></format></table></defaultValue></field><field description="Condition Expression" editor="expression" name="condition" type="S"><validators contentType="base64">HEweMSAyMTQ3NDgzNjQ3HQ==</validators><help>Expression that determines whether the menu item is displayed.</help><defaultValue/></field><field description="Action Expression" editor="expression" name="expression" nullable="true" type="S"><help>Expression executed when the menu item is clicked.</help><defaultValue><nullValue/></defaultValue></field></fields></format></entry><entry><int>6</int><format maxRecords="1" minRecords="1"><fields><field description="Type" name="imageType" type="I"><selectionValues><option description="Data Block">0</option><option description="URL">1</option></selectionValues><help>Defines whether the image is embedded into the dashboard as a binary data block or loaded from a URL.</help><defaultValue>0</defaultValue></field><field description="Image Data" name="imageData" type="A"><help>Embedded image data.</help><defaultValue><data><nullValue/></data></defaultValue></field><field description="Image URL" name="imageUrl" type="S"><help>Image URL. Can refer to a Media Library item or to any third party resource.</help><defaultValue/></field></fields><bindings><binding><reference>imageData#enabled</reference><expression>{imageType} == 0</expression></binding><binding><reference>imageUrl#enabled</reference><expression>{imageType} == 1</expression></binding></bindings></format></entry><entry><int>7</int><format><fields><field name="path" type="S"><defaultValue/></field></fields></format></entry><entry><int>8</int><format><fields><field description="Series" name="series" type="S"><defaultValue/></field><field description="Value" name="value" nullable="true" type="F"><defaultValue><nullValue/></defaultValue></field><field description="Category" name="category" type="S"><defaultValue/></field><field description="Group" name="group" nullable="true" type="S"><defaultValue/></field></fields></format></entry><entry><int>9</int><format><fields><field description="Series" editor="expression" name="series" type="S"><help>Name of the data series to apply the color to.</help><defaultValue/></field><field description="Value" editor="expression" name="value" type="S"><help>Expression evaluating to the data value.</help><defaultValue/></field><field description="Category" editor="expression" name="category" type="S"><help>Expression evaluating to the category value.</help><defaultValue/></field><field description="Group" editor="expression" name="group" nullable="true" type="S"><defaultValue/></field></fields></format></entry><entry><int>10</int><format><fields><field description="Series" name="series" type="S"><help>Name of the data series to apply the color to.</help><defaultValue/></field><field description="Color" name="color" type="C"><help>The color to assign to this series.</help><defaultValue>#000000FF</defaultValue></field></fields></format></entry><entry><int>11</int><format><fields><field description="Description" name="description" type="S"><help>Description text to display in the tooltip for this series.</help><defaultValue/></field><field description="Category" name="category" type="S"><help>Specifies the X axis category (tick) for which the tooltip description is displayed.</help><defaultValue/></field></fields></format></entry><entry><int>12</int><format maxRecords="1" minRecords="1"><fields><field description="Value" name="buttonValue" type="S"><help>Text label to display on the button.</help><defaultValue>+</defaultValue></field><field description="Style" name="buttonCss" type="S"><help>CSS style to apply to the button.</help><defaultValue/></field></fields></format></entry><entry><int>13</int><format maxRecords="1" minRecords="1"><fields><field description="Value" name="buttonValue" type="S"><help>Text label to display on the button.</help><defaultValue>-</defaultValue></field><field description="Style" name="buttonCss" type="S"><help>CSS style to apply to the button.</help><defaultValue/></field></fields></format></entry><entry><int>14</int><format maxRecords="1" minRecords="1"><fields><field description="Value" name="buttonValue" type="S"><help>Text label to display on the button.</help><defaultValue>Reset</defaultValue></field><field description="Style" name="buttonCss" type="S"><help>CSS style to apply to the button.</help><defaultValue/></field></fields></format></entry><entry><int>15</int><format><fields><field description="Name" name="sourceVariablesName" type="S"><help>Name used to identify this row as a data series.</help><defaultValue/></field><field description="Context" editor="context" name="sourceVariablesContext" type="S"><help>Path of the context containing the source variable.</help><defaultValue/></field><field description="Use Aggregated Data" name="sourceAggregationDataType" type="S"><selectionValues><option description="None">NONE</option><option description="Statistics">STATISTICS</option><option description="Granulation">GRANULATION</option><option description="Both">BOTH</option></selectionValues><help>Determines whether to use aggregated or raw data.</help><defaultValue>NONE</defaultValue></field><field description="Variable" extendableSelectionValues="true" name="sourceVariablesVariable" type="S"><help>Name of the variable used as the data source.</help><defaultValue/></field><field description="Expression" editor="expression" name="sourceVariablesExpression" type="S"><help>An expression that is evaluated every time the binding is processed. Its evaluation result is stored in binding Target.</help><defaultValue/></field><field description="Custom Timestamp Expression" editor="expression" name="sourceVariablesCustomTimeStampExpression" type="S"><help>An expression that is evaluated every time the binding is processed. Its evaluation result is stored in binding Target.</help><defaultValue/></field><field description="Propagate" name="sourceVariablesPropagate" type="B"><help>When enabled, data propagates from parent contexts.</help><defaultValue>0</defaultValue></field><field description="Aggregation" name="sourceVariablesAggregation" type="S"><selectionValues><option description="Average">average</option><option description="Minimum">minimum</option><option description="Maximum">maximum</option><option description="Summation">summation</option><option description="First">fist</option><option description="Last">last</option></selectionValues><help>Aggregation method for grouping variable values within each time period.</help><defaultValue>average</defaultValue></field><field description="Type" name="sourceVariablesType" type="S"><selectionValues><option description="Gauge">gauge</option><option description="Counter">counter</option><option description="Derive">derive</option><option description="Absolute">absolute</option></selectionValues><help>Defines how this row contributes data to the chart (as a series or category).</help><defaultValue>gauge</defaultValue></field></fields><bindings><binding><reference>sourceVariablesVariable#choices</reference><expression>callFunction('utilities', 'variablesByMask' , {sourceVariablesContext})</expression></binding></bindings></format></entry><entry><int>16</int><format><fields><field description="Name" name="eventDataName" type="S"><help>Name used to identify this row as a data series.</help><defaultValue/></field><field description="Context" editor="context" name="eventDataContext" type="S"><help>Path of the context containing the source event.</help><defaultValue/></field><field description="Event" extendableSelectionValues="true" name="eventDataEvent" type="S"><help>Name of the event used as the data source.</help><defaultValue/></field><field description="Expression" editor="expression" name="eventDataExpression" type="S"><help>An expression that is evaluated every time the binding is processed. Its evaluation result is stored in binding Target.</help><defaultValue/></field><field description="Custom Timestamp Expression" editor="expression" name="eventDataCustomTimeStampExpression" type="S"><help>An expression that is evaluated every time the binding is processed. Its evaluation result is stored in binding Target.</help><defaultValue/></field><field description="Aggregation" name="eventDataAggregation" type="S"><selectionValues><option description="Average">average</option><option description="Minimum">minimum</option><option description="Maximum">maximum</option><option description="Summation">summation</option><option description="First">fist</option><option description="Last">last</option></selectionValues><help>Aggregation method for grouping event values within each time period.</help><defaultValue>average</defaultValue></field></fields><bindings><binding><reference>eventDataEvent#choices</reference><expression>callFunction('utilities', 'eventsByMask' , {eventDataContext})</expression></binding></bindings></format></entry><entry><int>17</int><format><fields><field description="Series" name="series" type="S"><help>Name of the series (use 'series:category' format to target a specific category) to which this style applies.</help><defaultValue/></field><field description="Fill" name="fill" nullable="true" type="C"><help>Sets the fill color.</help><defaultValue><nullValue/></defaultValue></field><field description="Category" name="category" type="S"><help>Name of the category this row applies to.</help><defaultValue/></field><field description="Fill Opacity" name="fillOpacity" nullable="true" type="F"><validators contentType="base64">HEweMC4wIDEuMB0=</validators><help>Sets the fill opacity.</help><defaultValue><nullValue/></defaultValue></field><field description="Border Color" name="stroke" nullable="true" type="C"><help>Sets the border color.</help><defaultValue><nullValue/></defaultValue></field><field description="Border Width" name="lineWidth" nullable="true" type="I"><help>Sets the border width.</help><defaultValue><nullValue/></defaultValue></field><field description="Border Dash Interval" name="lineDash" nullable="true" type="S"><help>Specifies the dash pattern of the border.</help><defaultValue><nullValue/></defaultValue></field><field description="Border Opacity" name="strokeOpacity" nullable="true" type="F"><validators contentType="base64">HEweMC4wIDEuMB0=</validators><help>Controls the opacity of the border color.</help><defaultValue><nullValue/></defaultValue></field><field description="Shadow Color" name="shadowColor" nullable="true" type="C"><help>Sets the color of the shadow.</help><defaultValue><nullValue/></defaultValue></field><field description="Shadow Blur" name="shadowBlur" nullable="true" type="I"><help>Determines the blurring effect applied to the shadow.</help><defaultValue><nullValue/></defaultValue></field><field description="Shadow Offset X" name="shadowOffsetX" nullable="true" type="I"><help>Controls the horizontal offset of the shadow.</help><defaultValue><nullValue/></defaultValue></field><field description="Shadow Offset Y" name="shadowOffsetY" nullable="true" type="I"><help>Controls the vertical offset of the shadow.</help><defaultValue><nullValue/></defaultValue></field><field description="Cursor" name="cursor" nullable="true" type="S"><selectionValues><option description="Default">default</option><option description="Pointer">pointer</option><option description="Help">help</option><option description="Progress">progress</option><option description="Wait">wait</option><option description="None">none</option></selectionValues><help>Defines the cursor appearance.</help><defaultValue><nullValue/></defaultValue></field></fields></format></entry><entry><int>18</int><format><fields><field description="Series" keyfield="true" name="series" type="S"><help>Name of the data series to assign to this Y axis.</help><defaultValue/></field><field description="Position" name="position" type="S"><selectionValues><option description="Left">left</option><option description="Right">right</option></selectionValues><help>Position of this Y axis relative to the chart.</help><defaultValue>right</defaultValue></field><field description="Axis Title" name="axisTitle" type="T"><help>Title settings for this Y axis.</help><defaultValue><table><format maxRecords="1" minRecords="1"><fields><field description="Axis Label Enable" name="axisLabelEnableY" type="B"><help>Enables the display of a text label for the Y axis.</help><defaultValue>0</defaultValue></field><field description="Axis Label Offset" name="axisLabelOffsetY" type="I"><help>Number of pixels to offset the axis label from the Y axis.</help><defaultValue>5</defaultValue></field><field description="Axis Label Value" name="axisLabelValueY" type="S"><help>Text to display as the Y axis label.</help><defaultValue/></field><field description="Axis Label Text Color" name="axisLabelTextColorY" nullable="true" type="C"><help>Defines the color of the Y axis label text.</help><defaultValue><nullValue/></defaultValue></field><field description="Axis Label Font Size" name="axisLabelFontSizeY" type="I"><help>Font size of the Y axis label.</help><defaultValue>13</defaultValue></field></fields></format></table></defaultValue></field><field description="Axis Label" name="axisLabel" type="T"><help>Tick label settings for this Y axis.</help><defaultValue><table><format maxRecords="1" minRecords="1"><fields><field description="Show Axis Tick Labels" name="showYAxisTickLabels" type="B"><help>Displays a label for each tick on the Y axis.</help><defaultValue>1</defaultValue></field><field description="Tick Labels Offset" name="axisTickLabelsOffsetY" type="I"><help>Defines the number of pixels to offset the axis tick labels from the Y axis.</help><defaultValue>10</defaultValue></field><field description="Tick Labels Text Color" name="axisTickLabelsTextColorY" nullable="true" type="C"><help>Defines the text color of the Y axis tick labels.</help><defaultValue><nullValue/></defaultValue></field><field description="Tick Labels Font Size" name="axisTickLabelFontSizeY" type="I"><help>Defines the text size in pixels of the Y axis tick labels.</help><defaultValue>13</defaultValue></field></fields></format></table></defaultValue></field><field description="Axis Line" name="axisLine" type="T"><help>Line settings for this Y axis.</help><defaultValue><table><format maxRecords="1" minRecords="1"><fields><field description="Show Line" name="showYAxisLine" type="B"><help>Displays the line running along the axis.</help><defaultValue>0</defaultValue></field><field description="Line Width" name="axisLineWidthY" type="F"><help>Specifies the width of the axis line in pixels.</help><defaultValue>1</defaultValue></field><field description="Line Color" name="axisLineColorY" type="C"><help>Sets the color of the axis line.</help><defaultValue>#000000FF</defaultValue></field><field description="Line Opacity" name="axisLineOpacityY" type="F"><validators contentType="base64">HEweMC4wIDEuMB0=</validators><help>Controls the transparency of the axis line. Accepts a value between 0 (fully transparent) and 1 (fully opaque).</help><defaultValue>1</defaultValue></field><field description="Line Offset Top" name="axisLineOffsetTopY" type="I"><help>Sets the padding applied to the top of the axis line.</help><defaultValue>0</defaultValue></field><field description="Line Offset Bottom" name="axisLineOffsetBottomY" type="I"><help>Sets the padding applied to the bottom of the axis line.</help><defaultValue>0</defaultValue></field><field description="Line Offset Vertical" name="axisLineOffsetVerticalY" type="F"><help>Sets equal padding for the axis line from both the top and bottom edges.</help><defaultValue>0</defaultValue></field><field description="Line Offset Horizontal" name="axisLineOffsetHorizontalY" type="F"><help>Sets equal padding for the axis line from both the left and right edges.</help><defaultValue>0</defaultValue></field></fields></format></table></defaultValue></field><field description="Axis Tick" name="axisTick" type="T"><help>Tick mark settings for this Y axis.</help><defaultValue><table><format maxRecords="1" minRecords="1"><fields><field description="Show Tick" name="showYAxisTick" type="B"><help>Displays the tick marks on the axis.</help><defaultValue>1</defaultValue></field><field description="Tick Length" name="axisTickLengthY" type="F"><help>Specifies the length of the tick marks on the axis.</help><defaultValue>4</defaultValue></field><field description="Tick Width" name="axisTickLineWidthY" type="F"><help>Specifies the width of the tick marks on the axis.</help><defaultValue>1</defaultValue></field><field description="Tick Line Dash" name="axisTickLineDashY" type="S"><help>Specifies the dash pattern of the tick marks as two values: dash length and gap length (e.g., 1, 1).</help><defaultValue>0, 0</defaultValue></field><field description="Tick Color" name="axisTickColorY" type="C"><help>Sets the color of the tick marks on the axis.</help><defaultValue>#000000FF</defaultValue></field><field description="Tick Opacity" name="axisTickOpacityY" type="F"><validators contentType="base64">HEweMC4wIDEuMB0=</validators><help>Controls the transparency of the tick marks. Accepts a value between 0 (fully transparent) and 1 (fully opaque).</help><defaultValue>1</defaultValue></field></fields></format></table></defaultValue></field><field description="Axis Grid" name="axisGrid" type="T"><help>Grid settings associated with this Y axis.</help><defaultValue><table><format maxRecords="1" minRecords="1"><fields><field description="Grid Line Show Y" name="gridLineShowY" type="B"><help>Shows or hides the horizontal grid lines corresponding to tick marks along the Y axis.</help><defaultValue>1</defaultValue></field><field description="Vertical Grid Line Opacity" name="gridLineStyleOpacityY" type="F"><validators contentType="base64">HEweMC4wIDEuMB0=</validators><help>Defines the opacity of the horizontal grid lines indicating tick marks along the Y axis.</help><defaultValue>0.5</defaultValue></field><field description="Grid Line Color Y" name="gridLineStyleColorY" type="C"><help>Sets the color of the vertical grid lines in the chart background along the Y-axis.</help><defaultValue>#000000FF</defaultValue></field><field description="Grid Line Width Y" name="gridLineStyleWidthY" type="I"><help>Determines the width of the vertical grid lines in the chart background along the Y-axis.</help><defaultValue>1</defaultValue></field><field description="Grid Line Length Y" name="gridLineStyleLengthY" type="I"><help>Sets the length of the vertical grid lines in the chart background along the Y-axis.</help><defaultValue>1</defaultValue></field><field description="Grid Line Gap Length Y" name="gridLineStyleLengthGapY" type="I"><help>Sets the gap length between vertical grid lines in the chart background along the Y-axis.</help><defaultValue>1</defaultValue></field><field description="Grid Alternate Color Y" name="gridAlternateColorY" nullable="true" type="C"><help>Defines a color fill for alternating spaces between the horizontal grid lines along the Y axis.</help><defaultValue><nullValue/></defaultValue></field><field description="Grid Line Offset Y" name="gridLineStyleOffsetY" type="S"><help>Shifts the horizontal grid lines vertically. Accepts two values: offset from the top edge and offset from the bottom edge.</help><defaultValue>0, 0</defaultValue></field></fields></format></table></defaultValue></field></fields><validators contentType="base64">HEseHQ==</validators></format></entry><entry><int>19</int><format maxRecords="1" minRecords="1"><fields><field description="All Bindings" name="bindings" type="T"><defaultValue><table><format/></table></defaultValue></field><field description="Startup Bindings Concurrency" name="startupBindingsConcurrency" type="B"><help>If enabled, multiple threads will concurrently process all startup bindings. If disabled, all startup bindings are processed sequentially.</help><defaultValue>0</defaultValue></field><field description="Normal Concurrent Bindings" extendableSelectionValues="true" name="normalConcurrentBindings" type="I"><selectionValues><option description="Disabled">0</option></selectionValues><help>The maximum number of binding processing tasks under normal circumstances. If more than this number of tasks should start execution, further tasks are getting queued for later execution once execution threads get free.</help><defaultValue>5</defaultValue></field><field description="Maximum Concurrent Bindings" extendableSelectionValues="true" name="maximumConcurrentBindings" type="I"><selectionValues><option description="Disabled">0</option></selectionValues><help>The absolute maximum number of threads in a binding processing pool. If this maximum number is reached and there are even more tasks to be executed right now, their execution will either fail or block until the pool gets some free resources.</help><defaultValue>100</defaultValue></field><field description="Maximum Unprocessed Binding Queue Length" name="maximumBindingQueueLength" type="I"><help>The maximum number of binding processing tasks that can get queued. If the queue gets full, additional binding processing threads will be created in the pool until the Maximum Concurrent Bindings limit is reached.</help><defaultValue>1000</defaultValue></field><field description="Background Image" name="backgroundImage" type="T"><defaultValue><table><format/></table></defaultValue></field><field description="Variables Storage" name="variablesStorage" type="T"><defaultValue><table><format/></table></defaultValue></field><field description="Context Menu" name="contextMenu" type="T"><defaultValue><table><format/></table></defaultValue></field><field description="Show Header" name="showHeader" type="B"><help>Configures whether the dockable window header should be displayed.</help><defaultValue>1</defaultValue></field><field description="Header Title" name="dockTitle" type="S"><help>Dockable window header text.</help><aliases><alias>description</alias></aliases><defaultValue/></field><field description="Header Icon" name="dockIcon" type="T"><defaultValue><table><format/></table></defaultValue></field><field description="Maximizable" name="maximizable" type="B"><help>Configures whether the dockable window can be maximized.</help><defaultValue>1</defaultValue></field><field description="Collapsible" name="collapsible" type="B"><help>Configures whether the dockable window can be collapsed.</help><defaultValue>0</defaultValue></field><field description="Movable" name="dockMovable" type="B"><help>Configures whether the dockable window can be moved.</help><defaultValue>1</defaultValue></field><field description="Collapsed" name="dockCollapsed" type="B"><help>Configures whether the dockable window is collapsed.</help><defaultValue>0</defaultValue></field><field description="Floatable" name="dockFloatable" type="B"><help>Configures whether the dockable window can be floated.</help><defaultValue>1</defaultValue></field><field description="Resizable" name="dockResizable" type="B"><help>Configures whether the dockable window can be resized.</help><defaultValue>1</defaultValue></field><field description="Tab Position" name="dockTabPosition" type="S"><selectionValues><option description="Top">top</option><option description="Bottom">bottom</option><option description="Left">left</option><option description="Right">right</option></selectionValues><help>Configures the position of tabs appearing when the dockable window is stacked into a tabbed panel with other windows.</help><defaultValue>top</defaultValue></field><field description="Preferred Width" name="dockPreferredWidth" type="I"><help>Desired width of the dockable window when split into another component or a dashboard.</help><defaultValue>0</defaultValue></field><field description="Preferred Height" name="dockPreferredHeight" type="I"><help>Desired height of the dockable window when split into another component or a dashboard.</help><defaultValue>0</defaultValue></field><field description="Minimum Width" name="dockMinimumWidth" type="I"><help>Minimum width of the dockable window when split into another component or a dashboard. Overridden when the viewscreen does not have sufficient space for the minimum width.</help><defaultValue>0</defaultValue></field><field description="Minimum Height" name="dockMinimumHeight" type="I"><help>Minimum height of the dockable window when split into another component or a dashboard. Overridden when the viewscreen does not have sufficient space for the minimum height.</help><defaultValue>0</defaultValue></field><field description="Custom Classes" name="customClasses" type="S"><help>Custom CSS classes that may be used in the CSS style related properties.</help><defaultValue/></field><field description="Component Content Style" editor="code" name="style" nullable="true" type="S"><editorOptions>scss</editorOptions><help>CSS Style to be applied to the component.</help><defaultValue/></field><field description="Visible Children" name="visibleChildren" type="T"><defaultValue><table><format/></table></defaultValue></field><field description="Visible" name="preloaderVisible" type="B"><help>Toggles whether the preloader is displayed. When true, the entire component will be hidden behind the preloader during the loading phase.</help><defaultValue>0</defaultValue></field><field description="Class Name" name="preloaderClass" type="S"><help>CSS class name to add to the preloader image and text.</help><defaultValue/></field><field description="Text" name="preloaderText" type="S"><help>Text to display in the preloader.</help><defaultValue/></field><field description="Icon" name="preloaderIcon" type="T"><defaultValue><table><format/></table></defaultValue></field><field description="Generate Mouse Clicked Events" name="generateMouseClicked" type="B"><help>Controls whether the component generated Mouse Clicked events. Initially disabled for performance reasons.</help><defaultValue>1</defaultValue></field><field description="Generate Mouse Double Clicked Events" name="generateMouseDoubleClicked" type="B"><help>Controls whether the component generated Mouse Double events. Initially disabled for performance reasons.</help><defaultValue>0</defaultValue></field><field description="Generate Mouse Pressed Events" name="generateMousePressed" type="B"><help>Controls whether the component generated Mouse Pressed events. Initially disabled for performance reasons.</help><defaultValue>0</defaultValue></field><field description="Generate Mouse Released Events" name="generateMouseReleased" type="B"><help>Controls whether the component generated Mouse Released events. Initially disabled for performance reasons.</help><defaultValue>0</defaultValue></field><field description="Generate Mouse Entered Events" name="generateMouseEntered" type="B"><help>Controls whether the component generated Mouse Entered events. Initially disabled for performance reasons.</help><defaultValue>0</defaultValue></field><field description="Generate Mouse Exited Events" name="generateMouseExited" type="B"><help>Controls whether the component generated Mouse Exited events. Initially disabled for performance reasons.</help><defaultValue>0</defaultValue></field><field description="Component Bindings" name="componentBindings" type="T"><defaultValue><table><format/></table></defaultValue></field><field description="childContexts" name="childContexts" type="T"><defaultValue><table><format/></table></defaultValue></field><field description="Editable" name="editable" type="B"><defaultValue>1</defaultValue></field><field description="Enable Dynamic Contents" name="dynamicContentsEnabled" type="B"><help>Controls runtime creation of contents within the container. A container with dynamic contents must contain exactly one child component (or a single child hierarchy of components with a container-type root component). This component/hierarchy will be replicated for each row in the Dynamic Contents table, effectively adding new children to the container.</help><defaultValue>0</defaultValue></field><field description="Static Format" name="dynamicContentsUseStaticFormat" type="B"><help>When true, the Format property will define the format of the Dynamic Contents data table. This also allows putting a "static" dataset into the Dynamic Contents table via the component properties editor.</help><defaultValue>0</defaultValue></field><field description="Format" name="dynamicContentsFormat" type="T"><defaultValue><table><format/></table></defaultValue></field><field description="Dynamic Contents" name="dynamicContentsSource" type="T"><defaultValue><table><format/></table></defaultValue></field><field description="Component Name Suffix Expression" editor="expression" name="dynamicContentsSuffix" type="S"><help>An expression used to generate custom suffixes for the names of dynamically created components based on the current row of the Dynamic Contents dataset. If not specified, the contexts are named according to &lt;originalComponentName>{#row} pattern: if a name of the dynamic container's component being replicated is "template" its clones will be named "template1", "template2", etc.</help><defaultValue/></field><field description="Positioning" name="dynamicContentsPositioning" type="S"><selectionValues><option description="Automatic">AUTOMATIC</option><option description="Manual">MANUAL</option></selectionValues><help>When 'Automatic' is selected, the created components will be positioned next to each other according to the current container's layout, and with 'Manual' their constraints must be set with bindings.</help><defaultValue>AUTOMATIC</defaultValue></field><field description="Current Page Offset" name="currentPageOffset" type="I"><defaultValue>0</defaultValue></field><field description="Items Total Count" name="totalCount" type="I"><defaultValue>0</defaultValue></field><field description="Items Per Page" name="pageSize" type="I"><validators contentType="base64">HEweMSAyMTQ3NDgzNjQ3HQ==</validators><help>Number of dynamically created components (or component hierarchies) to display per page. If the number of dynamically created components exceeds this number, a paginator appears in the container, otherwise the components are displayed without pagination. Each page contains a unique set of components.</help><defaultValue>10</defaultValue></field><field description="Show 'Items per Page' Selector" name="showPageSizeSelector" type="B"><help>Gives the user an option to select the number of items to display per page, with selection values taken from Custom ‘Items Per Page’ Selection Values.</help><defaultValue>1</defaultValue></field><field description="'Items per Page' Selector Type" name="pageSizeSelectorType" type="S"><selectionValues><option description="Combo Box">combobox</option><option description="Button Group">button-group</option></selectionValues><help>Indicates what kind of selector to display to the user, allowing them to select the number of items to display per page.</help><defaultValue>combobox</defaultValue></field><field description="Custom 'Items per Page' Selection Values" name="pageSizeOptions" type="T"><defaultValue><table><format/></table></defaultValue></field><field description="Layout" name="layout" type="S"><selectionValues><option description="Grid">grid</option><option description="Absolute">absolute</option><option description="Dockable">dockable</option></selectionValues><help>&lt;p>Defines container layout type:&lt;/p>&lt;ul>&lt;li>&lt;b>Grid layout&lt;/b> is a matrix of rows and columns, allowing certain components to span multiple rows or columns. Rows can have different heights. Similarly, columns may have different widths. The grid may be shown or hidden when editing the dashboard in the UI Builder, but is never shown when the dashboard is running. Only the actual components are visible. Grid layout is backed by and rendered with &lt;i>CSS Grid&lt;/i> technology.&lt;/li>&lt;li>&lt;b>Absolute layout&lt;/b> defines constraints for each component by their pixel coordinates and size on the canvas. This may be very convenient for designing human-machine interfaces (HMIs), facility/floor plans, and other similar UIs. Components are moved, aligned and sized by dragging and dropping on the canvas, and can even overlap one another.&lt;/li>&lt;li>&lt;b>Dockable layout&lt;/b> empowers interface designers to craft flexible and customizable user interfaces by distributing components as floating windows, horizontally or vertically-aligned panes, or tabs within panes. The dashboard developer designs the initial layout of a dockable container and the extent it can be customized by the user, for example, whether windows can be closed or set as floating. End users are able to reorganize or minimize windows to create personalized layouts that suit their preferences. To edit a dockable layout, users and designers click and hold a window to open the layout selector. A menu will pop up, indicating the orientation of the window when dropped in a certain position.&lt;/li>&lt;/ul></help><defaultValue>grid</defaultValue></field><field description="Gap" name="gap" type="S"><help>Defines cell grid line width, in pixels.</help><defaultValue>10px</defaultValue></field><field description="Grid Column Properties" name="gridCols" type="T"><defaultValue><table><format/></table></defaultValue></field><field description="Grid Row Properties" name="gridRows" type="T"><defaultValue><table><format/></table></defaultValue></field><field description="Resizable" hidden="true" name="resizable" type="B"><defaultValue>1</defaultValue></field><field description="Movable" hidden="true" name="movable" type="B"><defaultValue>1</defaultValue></field><field description="Max columns" hidden="true" name="maxColumns" type="I"><defaultValue>2</defaultValue></field><field description="Max Rows" hidden="true" name="maxRows" type="I"><defaultValue>2</defaultValue></field><field description="Grid Type" name="gridType" type="S"><selectionValues><option description="Scrollable">scrollable</option><option description="Non-scrollable">dockable</option></selectionValues><help>&lt;p>Dashboard behavior when content does not fit into the screen:&lt;/p>&lt;ul>&lt;li>&lt;b>Scrollable&lt;/b> — a vertical scroll bar will appear when content overflows the screen;&lt;/li>&lt;li>&lt;b>Non-scrollable&lt;/b> — dashboard content will be fit to the screen.&lt;/li>&lt;/ul></help><defaultValue>dockable</defaultValue></field><field description="Show Grid" name="showGridBackground" type="S"><selectionValues><option description="None">none</option><option description="Rows">rows</option><option description="Columns">columns</option><option description="Rows And Columns">rowsAndColumns</option></selectionValues><help>Defines which grid lines are shown. This property is only applicable to editing mode, it does not affect normal dashboard operation.</help><defaultValue>rowsAndColumns</defaultValue></field><field description="Snap to Grid" name="snapToGrid" type="B"><help>Available in containers configured with Absolute layout. When enabled, overlays a snap-to grid on the canvas. This grid is invisible and non-functional during normal dashboard operation. During dashboard editing, components will automatically be aligned with the nearest horizontal and vertical lines of the snap-to grid. The cell size of the snap-to grid is determined by the Grid Step property.</help><defaultValue>0</defaultValue></field><field description="Dock Layout Structure" name="dockLayoutStructure" type="T"><defaultValue><table><format/></table></defaultValue></field><field description="Layout Storage" name="layoutStorage" type="S"><selectionValues><option description="Shared">shared</option><option description="For Every User">forEveryUser</option><option description="For Every Login">forEveryLogin</option><option description="Do Not Store">doNotStore</option></selectionValues><help>&lt;p>Determines how dockable layouts should be persisted between users and user sessions:&lt;/p>&lt;ul>&lt;li>&lt;b>Shared:&lt;/b> The layout will be shared between users. If one user makes a change to the layout, this will be applied to all users.&lt;/li>&lt;li>&lt;b>For Every User:&lt;/b> Each user will have their own layout saved, which will persist between sessions.&lt;/li>&lt;li>&lt;b>For Every Login:&lt;/b> The dockable layout will be persisted during a single session, but when the user logs out, the layout will return to the default.&lt;/li>&lt;li>&lt;b>Do Not Store:&lt;/b> The layout will revert to its default each time the user navigates away from the dashboard.&lt;/li>&lt;/ul></help><defaultValue>shared</defaultValue></field><field description="Grid Step" name="gridStep" type="S"><help>Applicable when the Snap to Grid property is enabled. Indicates the number of pixels between each column and row of the snap-to grid.</help><defaultValue>10</defaultValue></field><field description="Band Type" name="bandType" nullable="true" type="S"><help>Functional purpose and place of the band in the report generation life cycle</help><defaultValue><nullValue/></defaultValue></field><field description="Layout Width" name="layoutWidth" type="I"><help>Layout width for absolute layout, in pixels.</help><defaultValue>800</defaultValue></field><field description="Layout Height" name="layoutHeight" type="I"><help>Layout height for absolute layout, in pixels.</help><defaultValue>800</defaultValue></field><field description="Left Margin" name="marginLeft" type="I"><help>Left Margin</help><defaultValue>30</defaultValue></field><field description="Right Margin" name="marginRight" type="I"><help>Right Margin</help><defaultValue>30</defaultValue></field><field description="Top Margin" name="marginTop" type="I"><help>Top Margin</help><defaultValue>40</defaultValue></field><field description="Bottom Margin" name="marginBottom" type="I"><help>Bottom Margin</help><defaultValue>40</defaultValue></field><field description="Breakpoints" name="breakpoints" type="T"><defaultValue><table><format/></table></defaultValue></field><field description="Current Breakpoint" name="currentBreakpoint" type="S"><help>Name of the dashboard's active breakpoint. Must match a name defined in the Breakpoints table. During dashboard editing, this property is auto-adjusted when a breakpoint is selected from the Web UI Builder's top toolbar. During dashboard normal operation, this property is auto-adjusted when the dashboard is started and when the browser window is resized.</help><defaultValue>none</defaultValue></field><field description="Default Breakpoint" name="defaultBreakpoint" type="S"><help>Name of a breakpoint (as defined in Breakpoints table) that will be used to define styles and property values for a component that doesn't define custom styles and property values for breakpoint specified in Current Breakpoint property. Normally, this property points to None breakpoint. Note, that if a component don't have styles and property values pointed by both Current Breakpoint and Default Breakpoint, the component is completely hidden from the dashboard.</help><defaultValue>none</defaultValue></field><field description="Custom Properties" name="customProperties" type="T"><defaultValue><table><format/></table></defaultValue></field><field description="state" name="state" type="S"><selectionValues><option description="CREATED">CREATED</option><option description="STARTING">STARTING</option><option description="RUNNING">RUNNING</option><option description="PAUSED">PAUSED</option><option description="STOPPED">STOPPED</option></selectionValues><defaultValue>CREATED</defaultValue></field><field description="Show Empty Dashboard Message" name="showEmptyDashboardMessage" type="B"><help>Determines whether a message will be shown to users when viewing a dashboard that has no components on it. If enabled, displays a message and an Edit button when a dashboard contains no components. This helps users understand the state of the dashboard and encourages them to start adding content. When disabled, no message is displayed on empty dashboards, resulting in a somewhat confusing blank dashboard when no components are present.</help><defaultValue>1</defaultValue></field><field description="Printable" name="printable" type="B"><help>Dashboard type for creating printable reports</help><defaultValue>0</defaultValue></field><field description="Page Settings" name="pageSettings" type="T"><defaultValue><table><format/></table></defaultValue></field><field description="Name" name="name" nullable="true" type="S"><help>Unique name of the UI component within the dashboard. Since all UI components are represented by contexts located in the two-level component context tree, a component's name also equals to both the name and full path of the component context.</help><defaultValue/></field></fields></format></entry><entry><int>20</int><format reorderable="true"><fields><field hidden="true" keyfield="true" name="bindingId" notReplicated="true" nullable="true" type="L"><validators contentType="base64">HEweMCA5MjIzMzcyMDM2ODU0Nzc1ODA3HQ==</validators><defaultValue><nullValue/></defaultValue></field><field description="Target" editor="target" name="target" type="S"><help>A reference that points to where the evaluation result of a binding Expression will be applied/stored.</help><defaultValue/></field><field description="Expression" editor="expression" name="expression" type="S"><editorOptions contentType="base64"></editorOptions><help>An expression that is evaluated every time the binding is processed. Its evaluation result is stored in binding Target.</help><defaultValue/></field><field description="Activator" editor="activator" name="activator" type="S"><help>A reference that points to some event or variable (property). Occurrence of this event or change of this variable (property) triggers processing of the binding. If activator is not specified and On Event flag is set, the binding will be processed when any component of its Expression changes.</help><defaultValue/></field><field description="Condition" editor="expression" name="condition" type="S"><editorOptions contentType="base64"></editorOptions><help>An expression that is evaluated upon binding activation. The evaluation result should be a boolean that indicates whether the binding should be processed or not.</help><defaultValue/></field><field description="On Startup" name="onstartup" type="B"><help>When enabled, the binding is processed once the widget is launched.</help><defaultValue>0</defaultValue></field><field description="On Event" name="onevent" type="B"><help>When enabled, the binding is processed upon Activator event (or Activator state change, if activator is a property). If Activator is not specified, the binding is processed when any component of the Expression changes.</help><defaultValue>0</defaultValue></field><field description="Periodically" name="periodically" type="B"><help>When enabled, the binding will be processed periodically.</help><defaultValue>0</defaultValue></field><field description="Period" editor="period" name="period" type="L"><validators contentType="base64">HEweMSA5MjIzMzcyMDM2ODU0Nzc1ODA3HQ==</validators><help>Interval between periodical binding executions.</help><defaultValue>60000</defaultValue></field><field advanced="true" description="Queue" name="queue" type="S"><validators contentType="base64">HFIeXHcqXl5OYW1lIG1heSBjb250YWluIG9ubHkgTGF0aW4gbGV0dGVycywgZGlnaXRzLCBhbmQgdW5kZXJzY29yZXMd</validators><help>Target operations of bindings in the same queue are guaranteed to be performed sequentially.</help><defaultValue/></field></fields><bindings><binding><reference>expression#options</reference><expression>expressionEditorOptions({.:})</expression></binding><binding><reference>activator#enabled</reference><expression>{onevent}</expression></binding><binding><reference>period#enabled</reference><expression>{periodically}</expression></binding><binding><reference>bindingId</reference><expression>{bindingId}==null ? long(random()*9223372036854775807) : {bindingId}</expression></binding></bindings></format></entry><entry><int>21</int><format><fields><field description="childContexts" name="childContexts" type="S"><defaultValue/></field></fields></format></entry><entry><int>22</int><format maxRecords="1" minRecords="1" namingExpression="print({fields}, '{name}', ', ')"><fields><field description="Minimal Record Count" name="minRecords" type="I"><validators contentType="base64">HEweMCAyMTQ3NDgzNjQ3HQ==</validators><help>The number of records should be within this range, otherwise the table will be treated as &lt;i>invalid&lt;/i>.</help><defaultValue>0</defaultValue></field><field description="Maximal Record Count" extendableSelectionValues="true" name="maxRecords" type="I"><validators contentType="base64">HEweMCAyMTQ3NDgzNjQ3HQ==</validators><selectionValues><option description="Not limited">2147483647</option></selectionValues><help>The number of records should be within this range, otherwise the table will be treated as &lt;i>invalid&lt;/i>.</help><defaultValue>2147483647</defaultValue></field><field description="Fields" name="fields" type="T"><help>Each row in this property defines a field of the data table.</help><defaultValue><table><format reorderable="true"><fields><field hidden="true" name="oldname" type="S"><defaultValue/></field><field description="Name" name="name" type="S"><validators contentType="base64">HFIeXHcrXl5OYW1lIG1heSBjb250YWluIG9ubHkgTGF0aW4gbGV0dGVycywgZGlnaXRzLCBhbmQgdW5kZXJzY29yZXMd</validators><help>Name of the field. The name is used to refer the field.</help><defaultValue/></field><field description="Type" name="type" type="S"><selectionValues><option description="Integer">I</option><option description="String">S</option><option description="Boolean">B</option><option description="Long">L</option><option description="Float">F</option><option description="Double">E</option><option description="Decimal">N</option><option description="Date">D</option><option description="Data Table">T</option><option description="Color">C</option><option description="Data Block">A</option></selectionValues><help>Type of the field.</help><defaultValue>I</defaultValue></field><field description="Description" name="description" nullable="true" type="S"><validators contentType="base64">HFIeW15ccHtDbnRybH1dKl5eRGVzY3JpcHRpb24gbWF5IGNvbnRhaW4gb25seSBwcmludGFibGUgY2hhcmFjdGVycx0=</validators><help>Textual field description.</help><defaultValue><nullValue/></defaultValue></field><field description="Default" name="defaultValue" nullable="true" type="S"><help>Default value of the field. You can omit this only if the field is nullable.</help><defaultValue><nullValue/></defaultValue></field><field description="Read-only" name="readonly" type="B"><help>Flag indicating that the values in this field are read-only. This applied to the UI-level editing and some data model level operations as well.</help><defaultValue>0</defaultValue></field><field description="Nullable" name="nullable" type="B"><help>Flag indicating that field can contain NULL values.</help><defaultValue>0</defaultValue></field><field description="Key" name="key" type="B"><help>Flag indicating that the field is a part of record’s unique ID, which is a unique combination of all key fields defined in the table format. Any declared key fields usually force the Data Table Smart Copy operation to employ a special copy algorithm that match records by their unique key field combinations rather than record numbers.</help><defaultValue>0</defaultValue></field><field description="Selection Values" name="selvals" type="T"><help>List of values that can be selected for the field via a drop-down menu. A description must be defined for each value. Descriptions are shown when displaying the table to a user, and the values are available when the cell is referenced inside the platform.</help><defaultValue><table><format reorderable="true"><fields><field description="Value" keyfield="true" name="value" nullable="true" type="S"><defaultValue><nullValue/></defaultValue></field><field description="Description" name="description" type="S"><defaultValue/></field></fields><validators contentType="base64">HEseHQ==</validators></format></table></defaultValue></field><field description="Extendable Selection Values" name="extselvals" type="B"><help>Flag indicating the field may be set to any value, including ones not listed in Selection Values.</help><defaultValue>0</defaultValue></field><field advanced="true" description="Hidden" name="hidden" type="B"><help>The setting hides the field in the UI, but it remains accessible at the data model level.</help><defaultValue>0</defaultValue></field><field advanced="true" description="Inline" name="inline" type="B"><help>&lt;p>This flag has special meaning for different fields:&lt;/p>&lt;ul>&lt;li>If the Inline flag is set for a Data Block field, the field value will be stored in a dedicated database table. The value will not be initially loaded if the table itself is loaded from the database and sent to a IoT Platform Client or external application. The Data Block value will, however, contain a data block ID that can be used to force loading the Data Block data from the server database. This is suitable for large binary values, such as image, sound, and video files.&lt;/li>&lt;li>If Inline flag is set for a Color field, field value will be used to highlight records of the table when its being viewed/edited in a Data Table Editor. Its often feasible to combine Inline flag with a Hidden flag to hide the Color field itself from the table. See the Row Coloring section below for more information.&lt;/li>&lt;li>If Inline flag is set for a Data Table field, default value of the field will have same format as format of the table to which the field belongs. This effectively enables creation of tables with unlimited nesting using Data Table Editor.&lt;/li>&lt;/ul></help><defaultValue>0</defaultValue></field><field advanced="true" description="Encrypted" name="encrypted" type="B"><help>Enables database-level field value encryption.</help><defaultValue>0</defaultValue></field><field description="Help" editor="textarea" name="help" nullable="true" type="S"><validators contentType="base64">HFIeW15ccHtDbnRybH1dKl5eRGVzY3JpcHRpb24gbWF5IGNvbnRhaW4gb25seSBwcmludGFibGUgY2hhcmFjdGVycx0=</validators><help>Contents of the pop-up which is displayed to the user when hovering over a field.</help><defaultValue><nullValue/></defaultValue></field><field description="Editor/Viewer" extendableSelectionValues="true" name="editor" nullable="true" type="S"><selectionValues><option description="Default"><nullValue/></option><option description="List">list</option><option description="Date">date</option><option description="Time">time</option><option description="Date/Time">dateTime</option><option description="Bar">bar</option><option description="Bytes">bytes</option><option description="Format Mask">formatString</option><option description="Class Instance">instance</option><option description="Time Period">period</option><option description="Foreign Class Instance">foreignInstance</option><option description="Expression">expression</option><option description="Function Selector">functionselector</option><option description="Password">password</option><option description="Text Editor">text</option><option description="HTML">html</option><option description="Text Area">textarea</option><option description="Hierarchical List">hierarchicalList</option><option description="Embedded Text Area">etextarea</option><option description="Context">context</option><option description="Context Mask">contextmask</option><option description="Font">font</option><option description="IP Address">ip</option><option description="Box">box</option><option description="Image">image</option><option description="Sound">sound</option><option description="Hex">hex</option><option description="Reference">reference</option><option description="Activator">activator</option><option description="Code Editor">code</option><option description="Spinner">spinner</option><option description="Event Level">eventLevel</option><option description="Date Range">dateRange</option><option description="Evaluation">evaluation</option></selectionValues><help>This parameter defines how the field is shown and modified in the user interface.</help><defaultValue><nullValue/></defaultValue></field><field description="Editor Options" name="editorOptions" nullable="true" type="T"><help>Editor/renderer options that allow fine-tuning rendering of field values in the UI.</help><defaultValue><nullValue/></defaultValue></field><field description="Validators" name="validators" nullable="true" type="T"><help>List of validators used to check if value is suitable for the field, as well as validator options. The platform features several pre-configured validators, internally used by the system to verify user input.</help><defaultValue><table><format reorderable="true"><fields><field description="Type" name="validator" nullable="true" type="S"><selectionValues><option description="Default"><nullValue/></option><option description="ID">I</option><option description="Limits">L</option><option description="Non-Null">N</option><option description="Regex">R</option><option description="Expression">E</option></selectionValues><defaultValue><nullValue/></defaultValue></field><field description="Options" name="options" type="S"><defaultValue/></field></fields><bindings><binding><reference>options#options</reference><expression>{validator} == 'E' ? expressionEditorOptions(null) : ""</expression></binding></bindings></format></table></defaultValue></field><field description="Group" name="group" nullable="true" type="S"><help>A human-readable name of a field group. All fields that belong to the same group will appear together within the UI.</help><defaultValue><nullValue/></defaultValue></field></fields><bindings><binding><reference>editorOptions</reference><expression>callFunction("utilities", "editorOptions", {type}, {editor}, {editorOptions})</expression></binding><binding><reference>editor#choices</reference><expression>{utilities:editors('{type}')}</expression></binding></bindings><validators contentType="base64">HEseHRxWHh0=</validators></format></table></defaultValue></field><field description="Reorderable" name="reorderable" type="B"><help>This flag indicates that records in this table may be swapped (re-ordered) during table processing.</help><defaultValue>1</defaultValue></field><field description="Unresizable" name="unresizable" type="B"><help>This flag indicates that users cannot add or remove rows when editing the table.</help><defaultValue>0</defaultValue></field><field description="Bindings" name="bindings" type="T"><help>A list of data bindings that define how the values in the table are changed when other table cells, or environment variables, are changed during table processing.</help><defaultValue><table><format reorderable="true"><fields><field description="Target" name="target" type="S"><validators contentType="base64">HEweMSAyMTQ3NDgzNjQ3HQ==</validators><help>The binding's &lt;i>Target&lt;/i> field has the following syntax: &lt;b>variable$field[row]#property&lt;/b>. All elements of the binding target are optional, except for the &lt;b>field&lt;/b>. It indicates the field in the table to which changes should be applied.</help><defaultValue/></field><field description="Expression" editor="expression" name="expression" type="S"><editorOptions contentType="base64"></editorOptions><validators contentType="base64">HEweMSAyMTQ3NDgzNjQ3HQ==</validators><help>The binding expression may contain only standard references. If a reference points to a cell within the table being edited, it will resolve to the value currently contained in the cell (which may be edited by a user, or written by other binding). In all other cases value will be retrieved from the server context, as described in standard references section.</help><defaultValue/></field></fields></format></table></defaultValue></field><field advanced="true" description="Encoded" editor="textarea" name="encoded" readonly="true" type="S"><help>Encoded table format</help><defaultValue/></field><field description="Naming Expression" editor="expression" name="namingExpression" nullable="true" type="S"><editorOptions contentType="base64"></editorOptions><help>An Expression that defines how the table is presented to the users in the interface. It must return a string that will be user as the table's description.</help><defaultValue><nullValue/></defaultValue></field></fields><validators contentType="base64">HEUeZTIxcGJsSmxZMjl5WkhOOUlEdzlJSHR0WVhoU1pXTnZjbVJ6ZlNBL0lHNTFiR3dnT2lBblZHaGxJRzFoZUdsdGRXMGdiblZ0WW1WeUlHOW1JSEpsWTI5eVpITWdZMkZ1Ym05MElHSmxJR3h2ZDJWeUlIUm9ZVzRnZEdobElHMXBibWx0ZFcwbh0=</validators></format></entry><entry><int>23</int><format><fields><field description="Value" name="pageSizeOptionsValue" type="I"><help>Number of items per page.</help><defaultValue>10</defaultValue></field></fields></format></entry><entry><int>24</int><format><fields><field description="Template" name="template" type="S"><help>Numeric value of the grid row/column size.</help><defaultValue>1</defaultValue></field><field description="Unit" extendableSelectionValues="true" name="unit" type="S"><selectionValues><option description="custom">custom</option><option description="auto">auto</option><option description="fr">fr</option><option description="px">px</option><option description="%">%</option><option description="pt">pt</option><option description="cm">cm</option><option description="mm">mm</o