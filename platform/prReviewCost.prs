ich evaluates to the tag attribute value string.</help><defaultValue/></field></fields></format></table></defaultValue></field><field description="Content Expression" editor="expression" name="contentExpression" nullable="true" type="S"><editorOptions contentType="base64"></editorOptions><help>An expression that must evaluate to a string, which is processed as the tag content value. The expression is evaluated at the moment the dashboard is being opened. Evaluation result is HTML-escaped before inserted into the HTML markup.</help><defaultValue><nullValue/></defaultValue></field></fields><bindings><binding><reference>name#enabled</reference><expression>{type} == "tag"</expression></binding><binding><reference>attributes#enabled</reference><expression>{type} == "tag"</expression></binding></bindings></format></entry><entry><int>45</int><format><fields><field description="ID" name="id" type="S"><defaultValue/></field><field description="Username" name="user" nullable="true" type="S"><defaultValue><nullValue/></defaultValue></field><field description="Layout Data" name="layoutData" type="T"><defaultValue><table><format><fields><field description="ID" name="id" type="S"><help>If this element was previously docked, this is the ID of the panel it was docked to before it became a floating element.</help><defaultValue/></field><field description="Parent ID" name="parentId" nullable="true" type="S"><help>ID of the parent element.</help><defaultValue><nullValue/></defaultValue></field><field description="Order ID" name="orderId" type="I"><help>Order of the element within its parent container.</help><defaultValue>0</defaultValue></field><field description="Mode" name="mode" nullable="true" type="S"><help>Mode of the element (e.g., 'dock', 'float').</help><defaultValue><nullValue/></defaultValue></field><field description="Size" name="size" type="I"><help>Size of the element.</help><defaultValue>0</defaultValue></field><field description="X" name="x" nullable="true" type="E"><h