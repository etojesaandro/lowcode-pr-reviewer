="&lt;div> / Block Container">div</option><option description="&lt;p> / Paragraph">p</option><option description="&lt;a> / Anchor">a</option><option description="&lt;code> / Code">code</option><option description="&lt;blockquote> / Quotation">blockquote</option><option description="&lt;h1> / Heading 1">h1</option><option description="&lt;h2> / Heading 2">h2</option><option description="&lt;h3> / Heading 3">h3</option><option description="&lt;h4> / Heading 4">h4</option><option description="&lt;h5> / Heading 5">h5</option><option description="&lt;h6> / Heading 6">h6</option></selectionValues><help>HTML tag which should enclose the rendered label component.</help><defaultValue>span</defaultValue></field><field description="Content" editor="html" name="tooltipContent" type="S"><help>Text or HTML content to be displayed in the tooltip.</help><defaultValue/></field><field description="Placement" name="tooltipPlacement" type="S"><selectionValues><option description="Top">top</option><option description="Top Right">topRight</option><option description="Top Left">topLeft</option><option description="Right">right</option><option description="Right Top">rightTop</option><option description="Right Bottom">rightBottom</option><option description="Bottom">bottom</option><option description="Bottom Right">bottomRight</option><option description="Bottom Left">bottomLeft</option><option description="Left">left</option><option description="Left Top">leftTop</option><option description="Left Bottom">leftBottom</option></selectionValues><help>Position of the tooltip relative to the component.</help><defaultValue>top</defaultValue></field><field description="Color" name="tooltipColor" type="C"><help>Background color of the tooltip bubble.</help><defaultValue>#404040FF</defaultValue></field><field description="Mouse Enter Delay" editor="period" name="tooltipMouseEnterDelay" type="L"><editorOptions>0 1</editorOptions><help>Delay time before the tooltip appears when the mouse cursor enter