<?xml version='1.0' encoding='UTF-8'?><root><properties><properties class="linked-hash-map"><entry><string>inheritanceProfile</string><table><formatId id="0"/></table></entry><entry><string>inheritance</string><table><formatId id="1"/></table></entry><entry><string>childInfo</string><table><formatId id="2"/><records><record><value name="name">prReviewer</value><value name="description">Claude Code review of Bitbucket PRs linked to Jira bugs</value></record></records></table></entry><entry><string>modelVariables</string><table><formatId id="3"/><records><record><value name="name">config</value><value name="description">Reviewer Configuration</value><value name="format"><table><formatId id="4"/><records><record><value name="minRecords">1</value><value name="maxRecords">1</value><value name="fields"><table><formatId id="5"/><records><record><value name="name">enabled</value><value name="type">B</value><value name="description">Polling Enabled</value><value name="defaultValue">false</value></record><record><value name="name">postComments</value><value name="type">B</value><value name="description">Post Comments to Bitbucket</value><value name="defaultValue">false</value></record><record><value name="name">requestChanges</value><value name="type">B</value><value name="description">Request Changes On MAJOR or BLOCKING Findings</value><value name="defaultValue">true</value></record><record><value name="name">workspace</value><value name="type">S</value><value name="description">Bitbucket Workspace</value><value name="defaultValue">my-workspace</value></record><record><value name="name">repo</value><value name="type">S</value><value name="description">Bitbucket Repository</value><value name="defaultValue">my-repository</value></record><record><value name="name">destinationRegex</value><value name="type">S</value><value name="description">Destination Branch Regex</value><value name="defaultValue">.*</value><value name="help">Only PRs targeting a matching branch are considered</value></record><record><value name="name">jiraKeyRegex</value><value name="type">S</value><value name="description">Jira Key Regex</value><value name="defaultValue">[A-Z][A-Z0-9]+-[0-9]+</value></record><record><value name="name">bugTypes</value><value name="type">S</value><value name="description">Issue Types To Review</value><value name="defaultValue">Bug,Performance Issue</value><value name="help">Comma-separated Jira issue type names</value></record><record><value name="name">runAsUser</value><value name="type">S</value><value name="description">Run Claude As User</value><value name="defaultValue">reviewer</value></record><record><value name="name">runnerScript</value><value name="type">S</value><value name="description">Runner Script</value><value name="defaultValue">/usr/local/bin/pr-review.sh</value></record><record><value name="name">model</value><value name="type">S</value><value name="description">Claude Model</value><value name="defaultValue">opus</value></record><record><value name="name">effort</value><value name="type">S</value><value name="description">Claude Effort</value><value name="defaultValue">medium</value><value name="help">low, medium, high, xhigh or max</value></record><record><value name="name">maxTurns</value><value name="description">Max Agent Turns</value><value name="defaultValue">40</value></record><record><value name="name">timeoutMinutes</value><value name="description">Review Timeout, minutes</value><value name="defaultValue">20</value></record><record><value name="name">maxReviewsPerCycle</value><value name="description">Max Reviews Per Poll</value><value name="defaultValue">2</value></record><record><value name="name">maxChangedLines</value><value name="description">Max Changed Lines</value><value name="defaultValue">500</value><value name="help">Lines added plus removed, excluding files matching sizeExcludeRegex</value></record><record><value name="name">maxChangedFiles</value><value name="description">Max Changed Files</value><value name="defaultValue">20</value></record><record><value name="name">sizeExcludeRegex</value><value name="type">S</value><value name="description">Files Not Counted In Size</value><value name="defaultValue">(^|/)(package-lock[.]json|yarn[.]lock|pnpm-lock[.]yaml)$|[.]d[.]ts$|(^|/)generated/</value><value name="help">Regex searched in each changed file path</value></record></records></table></value><value name="reorderable">0</value><value name="unresizable">1</value></record></records></table></value><value name="help">runnerScript is executed as: sudo -n -u &lt;runAsUser> &lt;runnerScript> &lt;prId> &lt;commit> &lt;destination> &lt;model> &lt;maxTurns> &lt;effort>. postComments=false is a dry run: the review runs and is recorded (status DRY_RUN, text in the reviewCompleted event) but nothing is posted. requestChanges marks a PR as Changes requested when its posted review has a MAJOR or BLOCKING finding. Bug PRs over maxChangedLines or maxChangedFiles are skipped; files matching sizeExcludeRegex do not count.</value></record><record><value name="name">prompts</value><value name="description">Prompts</value><value name="format"><table><formatId id="4"/><records><record><value name="fields"><table><formatId id="5"/><records><record><value name="name">name</value><value name="type">S</value><value name="description">Name</value><value name="key">1</value></record><record><value name="name">text</value><value name="type">S</value><value name="description">Text</value><value name="editor">textarea</value></record></records></table></value></record></records></table></value><value name="help">system: appended to Claude Code's system prompt. task: user prompt; placeholders {prId} {title} {source} {destination} {commit} {jiraKey} {issueType} {jiraSummary} {prUrl}</value></record><record><value name="name">ledger</value><value name="description">Review Ledger</value><value name="format"><table><formatId id="4"/><records><record><value name="fields"><table><formatId id="5"/><records><record><value name="name">prId</value><value name="description">PR</value><value name="key">1</value></record><record><value name="name">commit</value><value name="type">S</value><value name="description">Head Commit</value><value name="key">1</value></record><record><value name="name">title</value><value name="type">S</value><value name="description">Title</value><value name="nullable">1</value></record><record><value name="name">jiraKey</value><value name="type">S</value><value name="description">Jira Key</value><value name="nullable">1</value></record><record><value name="name">issueType</value><value name="type">S</value><value name="description">Issue Type</value><value name="nullable">1</value></record><record><value name="name">status</value><value name="type">S</value><value name="description">Status</value><value name="defaultValue">SKIPPED</value></record><record><value name="name">startedAt</value><value name="type">D</value><value name="description">Started</value><value name="nullable">1</value></record><record><value name="name">finishedAt</value><value name="type">D</value><value name="description">Finished</value><value name="nullable">1</value></record><record><value name="name">commentId</value><value name="type">S</value><value name="description">Comment Id</value><value name="nullable">1</value></record><record><value name="name">error</value><value name="type">S</value><value name="description">Error</value><value name="nullable">1</value></record></records></table></value><value name="reorderable">0</value></record></records></table></value><value name="help">One row per PR and head commit; a present row prevents a repeated review. Delete a row to force a re-review.</value><value name="historyRate">-1</value></record><record><value name="name">tokenTotals</value><value name="description">Token Totals</value><value name="format"><table><formatId id="4"/><records><record><value name="minRecords">1</value><value name="maxRecords">1</value><value name="fields"><table><formatId id="5"/><records><record><value name="name">reviews</value><value name="type">L</value><value name="description">Reviews</value><value name="defaultValue">0</value></record><record><value name="name">failed</value><value name="type">L</value><value name="description">Failed</value><value name="defaultValue">0</value></record><record><value name="name">inputTokens</value><value name="type">L</value><value name="description">Input Tokens</value><value name="defaultValue">0</value></record><record><value name="name">outputTokens</value><value name="type">L</value><value name="description">Output Tokens</value><value name="defaultValue">0</value></record><record><value name="name">cacheReadTokens</value><value name="type">L</value><value name="description">Cache Read Tokens</value><value name="defaultValue">0</value></record><record><value name="name">cacheCreationTokens</value><value name="type">L</value><value name="description">Cache Creation Tokens</value><value name="defaultValue">0</value></record><record><value name="name">costUsd</value><value name="type">E</value><value name="description">Cost, USD</value><value name="defaultValue">0</value></record><record><value name="name">durationMs</value><value name="type">L</value><value name="description">Total Duration, ms</value><value name="defaultValue">0</value></record></records></table></value><value name="reorderable">0</value><value name="unresizable">1</value></record></records></table></value><value name="help">Cumulative counters; value history is kept for a year for trend charts</value><value name="writePermissions">admin</value><value name="updateHistoryStorageTime">31536000000</value></record><record><value name="name">lastPoll</value><value name="description">Last Poll</value><value name="format"><table><formatId id="4"/><records><record><value name="minRecords">1</value><value name="maxRecords">1</value><value name="fields"><table><formatId id="5"/><records><record><value name="name">time</value><value name="type">D</value><value name="description">Time</value><value name="nullable">1</value></record><record><value name="name">openPrs</value><value name="description">Open PRs</value><value name="defaultValue">0</value></record><record><value name="name">reviewed</value><value name="description">Reviewed</value><value name="defaultValue">0</value></record><record><value name="name">skipped</value><value name="description">Skipped</value><value name="defaultValue">0</value></record><record><value name="name">failed</value><value name="description">Failed</value><value name="defaultValue">0</value></record><record><value name="name">error</value><value name="type">S</value><value name="description">Error</value><value name="nullable">1</value></record></records></table></value><value name="reorderable">0</value><value name="unresizable">1</value></record></records></table></value><value name="writePermissions">admin</value><value name="storageMode">1</value></record></records></table></entry><entry><string>modelFunctions</string><table><formatId id="6"/><records><record><value name="name">request</value><value name="description">HTTP JSON request through a device with preemptive auth</value><value name="inputformat"><table><formatId id="4"/><records><record><value name="minRecords">1</value><value name="maxRecords">1</value><value name="fields"><table><formatId id="5"/><records><record><value name="name">device</value><value name="type">S</value><value name="description">Device Path</value></record><record><value name="name">method</value><value name="type">S</value><value name="description">Method</value></record><record><value name="name">url</value><value name="type">S</value><value name="description">URL</value></record><record><value name="name">body</value><value name="type">S</value><value name="description">Body</value><value name="nullable">1</value></record></records></table></value><value name="reorderable">0</value><value name="unresizable">1</value></record></records></table></value><value name="outputformat"><table><formatId id="4"/><records><record><value name="minRecords">1</value><value name="maxRecords">1</value><value name="fields"><table><formatId id="5"/><records><record><value name="name">replyCode</value><value name="description">Reply Code</value><value name="nullable">1</value></record><record><value name="name">reply</value><value name="type">S</value><value name="description">Reply</value><value name="nullable">1</value></record></records></table></value><value name="reorderable">0</value><value name="unresizable">1</value></record></records></table></value><value name="group">prReviewer</value><value name="permissions">admin</value><value name="type">0</value><value name="implementation">import com.tibbo.aggregate.common.context.*;
import com.tibbo.aggregate.common.datatable.*;
import com.tibbo.aggregate.common.server.*;

import com.tibbo.linkserver.*;
import com.tibbo.linkserver.context.*;

import java.nio.charset.StandardCharsets;
import java.util.Base64;

/**
 * Sends a JSON request through an HTTP device. Unlike httpExecuteRequest alone, it keeps the
 * device's own headers and sends its username/password preemptively as Basic auth, since Jira
 * and Bitbucket Cloud answer 404 rather than 401 to anonymous requests.
 *
 * @author Alexander Sidorov
 *     &lt;p>(co-authored with Claude Opus 5.5)
 */
public class %ScriptClassNamePattern% implements FunctionImplementation {
  private static final String HEADER_NAME = "headerName";
  private static final String HEADER_VALUE = "headerValue";

  public DataTable execute(Context con, FunctionDefinition def, CallerController caller,
      RequestController request, DataTable parameters) throws ContextException {
    DataRecord in = parameters.rec();
    String path = in.getString("device");
    String method = in.getString("method");
    String body = in.getString("body");
    Context device = con.getContextManager().get(path, caller);
    if (device == null) {
      throw new ContextException("HTTP device not found: " + path);
    }
    DataRecord props = device.getVariable("connectionProperties", caller).rec();
    DataTable stored = props.getDataTable("additionalHeaders");
    DataTable headers = stored.clone();
    boolean basic = Boolean.TRUE.equals(props.getBoolean("enableAuthentication"))
        &amp;&amp; props.getString("userName") != null &amp;&amp; !props.getString("userName").isEmpty();
    for (int i = headers.getRecordCount() - 1; i >= 0; i--) {
      String name = headers.getRecord(i).getString(HEADER_NAME);
      if ("Content-Type".equalsIgnoreCase(name) || "Accept".equalsIgnoreCase(name)
          || (basic &amp;&amp; "Authorization".equalsIgnoreCase(name))) {
        headers.removeRecord(i);
      }
    }
    headers.addRecord().setValue(HEADER_NAME, "Content-Type")
        .setValue(HEADER_VALUE, "application/json");
    headers.addRecord().setValue(HEADER_NAME, "Accept").setValue(HEADER_VALUE, "application/json");
    if (basic) {
      String pair = props.getString("userName") + ":" + props.getString("password");
      headers.addRecord().setValue(HEADER_NAME, "Authorization").setValue(HEADER_VALUE,
          "Basic " + Base64.getEncoder().encodeToString(pair.getBytes(StandardCharsets.UTF_8)));
    }
    DataRecord reply = device.callFunction("httpExecuteRequest", caller, in.getString("url"),
        method, "POST".equals(method) ? body : null, headers, "UTF-8",
        "PUT".equals(method) ? body : null).rec();
    if (!Boolean.TRUE.equals(reply.getBoolean("successful"))) {
      throw new ContextException(path + " " + method + " " + in.getString("url") + " failed: "
          + reply.getString("error"));
    }
    return new SimpleDataTable(def.getOutputFormat(), reply.getInt("replyCode"),
        reply.getString("reply"));
  }
}
</value></record><record><value name="name">openPrs</value><value name="description">Open pull requests of the configured repository</value><value name="inputformat"><table><formatId id="4"/><records><record><value name="maxRecords">1</value><value name="reorderable">0</value></record></records></table></value><value name="outputformat"><table><formatId id="4"/><records><record><value name="fields"><table><formatId id="5"/><records><record><value name="name">prId</value><value name="description">PR</value></record><record><value name="name">title</value><value name="type">S</value><value name="description">Title</value></record><record><value name="name">source</value><value name="type">S</value><value name="description">Source Branch</value></record><record><value name="name">destination</value><value name="type">S</value><value name="description">Destination Branch</value></record><record><value name="name">commit</value><value name="type">S</value><value name="description">Head Commit</value></record><record><value name="name">url</value><value name="type">S</value><value name="description">URL</value></record></records></table></value><value name="reorderable">0</value></record></records></table></value><value name="group">prReviewer</value><value name="permissions">admin</value><value name="type">0</value><value name="implementation">import com.tibbo.aggregate.common.context.*;
import com.tibbo.aggregate.common.datatable.*;
import com.tibbo.aggregate.common.server.*;

import com.tibbo.linkserver.*;
import com.tibbo.linkserver.context.*;

import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;

/**
 * Lists open pull requests of the configured Bitbucket Cloud repository, following pagination.
 *
 * @author Alexander Sidorov
 *     &lt;p>(co-authored with Claude Opus 5.5)
 */
public class %ScriptClassNamePattern% implements FunctionImplementation {
  private static final String BITBUCKET = "users.admin.devices.bitbucket";
  private static final String API = "https://api.bitbucket.org";
  private static final int MAX_PAGES = 40;

  public DataTable execute(Context con, FunctionDefinition def, CallerController caller,
      RequestController request, DataTable parameters) throws ContextException {
    DataRecord cfg = con.getVariable("config", caller).rec();
    String next = "/2.0/repositories/" + cfg.getString("workspace") + "/" + cfg.getString("repo")
        + "/pullrequests?state=OPEN&amp;pagelen=50&amp;fields=next,values.id,values.title,"
        + "values.source.branch.name,values.source.commit.hash,"
        + "values.destination.branch.name,values.links.html.href";
    DataTable result = new SimpleDataTable(def.getOutputFormat());
    ObjectMapper json = new ObjectMapper();
    int pages = 0;
    while (next != null) {
      if (++pages > MAX_PAGES) {
        throw new ContextException("Bitbucket pagination exceeded " + MAX_PAGES + " pages");
      }
      DataRecord reply = con.callFunction("request", caller, BITBUCKET, "GET", next, null).rec();
      if (reply.getInt("replyCode") != 200) {
        throw new ContextException("Bitbucket replied " + reply.getInt("replyCode") + ": "
            + reply.getString("reply"));
      }
      JsonNode root;
      try {
        root = json.readTree(reply.getString("reply"));
      } catch (Exception ex) {
        throw new ContextException("Unparseable Bitbucket reply: " + ex.getMessage(), ex);
      }
      for (JsonNode pr : root.path("values")) {
        result.addRecord(pr.path("id").asInt(), pr.path("title").asText(),
            pr.path("source").path("branch").path("name").asText(),
            pr.path("destination").path("branch").path("name").asText(),
            pr.path("source").path("commit").path("hash").asText(),
            pr.path("links").path("html").path("href").asText());
      }
      JsonNode link = root.path("next");
      next = link.isTextual() ? link.asText().replace(API, "") : null;
    }
    return result;
  }
}
</value></record><record><value name="name">issueOf</value><value name="description">Jira issue type and summary</value><value name="inputformat"><table><formatId id="4"/><records><record><value name="minRecords">1</value><value name="maxRecords">1</value><value name="fields"><table><formatId id="5"/><records><record><value name="name">key</value><value name="type">S</value><value name="description">Jira Key</value></record></records></table></value><value name="reorderable">0</value><value name="unresizable">1</value></record></records></table></value><value name="outputformat"><table><formatId id="4"/><records><record><value name="minRecords">1</value><value name="maxRecords">1</value><value name="fields"><table><formatId id="5"/><records><record><value name="name">found</value><value name="type">B</value><value name="description">Found</value></record><record><value name="name">issueType</value><value name="type">S</value><value name="description">Issue Type</value><value name="nullable">1</value></record><record><value name="name">summary</value><value name="type">S</value><value name="description">Summary</value><value name="nullable">1</value></record></records></table></value><value name="reorderable">0</value><value name="unresizable">1</value></record></records></table></value><value name="group">prReviewer</value><value name="permissions">admin</value><value name="type">0</value><value name="implementation">import com.tibbo.aggregate.common.context.*;
import com.tibbo.aggregate.common.datatable.*;
import com.tibbo.aggregate.common.server.*;

import com.tibbo.linkserver.*;
import com.tibbo.linkserver.context.*;

import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;

/**
 * Looks up a Jira issue's type and summary; an unknown or invisible key yields found=false.
 *
 * @author Alexander Sidorov
 *     &lt;p>(co-authored with Claude Opus 5.5)
 */
public class %ScriptClassNamePattern% implements FunctionImplementation {
  private static final String JIRA = "users.admin.devices.jira";

  public DataTable execute(Context con, FunctionDefinition def, CallerController caller,
      RequestController request, DataTable parameters) throws ContextException {
    String key = parameters.rec().getString("key");
    if (key == null || !key.matches("[A-Z][A-Z0-9]+-[0-9]+")) {
      throw new ContextException("Not a Jira key: " + key);
    }
    DataRecord reply = con.callFunction("request", caller, JIRA, "GET",
        "/rest/api/3/issue/" + key + "?fields=issuetype,summary", null).rec();
    int code = reply.getInt("replyCode");
    if (code == 404) {
      return new SimpleDataTable(def.getOutputFormat(), false, null, null);
    }
    if (code != 200) {
      throw new ContextException("Jira replied " + code + " for " + key + ": "
          + reply.getString("reply"));
    }
    try {
      JsonNode fields = new ObjectMapper().readTree(reply.getString("reply")).path("fields");
      return new SimpleDataTable(def.getOutputFormat(), true,
          fields.path("issuetype").path("name").asText(), fields.path("summary").asText());
    } catch (Exception ex) {
      throw new ContextException("Unparseable Jira reply for " + key + ": " + ex.getMessage(), ex);
    }
  }
}
</value></record><record><value name="name">postComment</value><value name="description">Post a general comment on a Bitbucket PR</value><value name="inputformat"><table><formatId id="4"/><records><record><value name="minRecords">1</value><value name="maxRecords">1</value><value name="fields"><table><formatId id="5"/><records><record><value name="name">prId</value><value name="description">PR</value></record><record><value name="name">text</value><value name="type">S</value><value name="description">Text</value></record></records></table></value><value name="reorderable">0</value><value name="unresizable">1</value></record></records></table></value><value name="outputformat"><table><formatId id="4"/><records><record><value name="minRecords">1</value><value name="maxRecords">1</value><value name="fields"><table><formatId id="5"/><records><record><value name="name">commentId</value><value name="type">S</value><value name="description">Comment Id</value><value name="nullable">1</value></record></records></table></value><value name="reorderable">0</value><value name="unresizable">1</value></record></records></table></value><value name="group">prReviewer</value><value name="permissions">admin</value><value name="type">0</value><value name="implementation">import com.tibbo.aggregate.common.context.*;
import com.tibbo.aggregate.common.datatable.*;
import com.tibbo.aggregate.common.server.*;

import com.tibbo.linkserver.*;
import com.tibbo.linkserver.context.*;

import com.fasterxml.jackson.databind.ObjectMapper;
import com.fasterxml.jackson.databind.node.ObjectNode;

/**
 * Posts a Markdown text as a general comment on a Bitbucket pull request.
 *
 * @author Alexander Sidorov
 *     &lt;p>(co-authored with Claude Opus 5.5)
 */
public class %ScriptClassNamePattern% implements FunctionImplementation {
  private static final String BITBUCKET = "users.admin.devices.bitbucket";

  public DataTable execute(Context con, FunctionDefinition def, CallerController caller,
      RequestController request, DataTable parameters) throws ContextException {
    DataRecord in = parameters.rec();
    String text = in.getString("text");
    if (text == null || text.isBlank()) {
      throw new ContextException("Refusing to post an empty comment");
    }
    DataRecord cfg = con.getVariable("config", caller).rec();
    ObjectMapper json = new ObjectMapper();
    ObjectNode body = json.createObjectNode();
    body.putObject("content").put("raw", text);
    DataRecord reply = con.callFunction("request", caller, BITBUCKET, "POST",
        "/2.0/repositories/" + cfg.getString("workspace") + "/" + cfg.getString("repo")
            + "/pullrequests/" + in.getInt("prId") + "/comments", body.toString()).rec();
    if (reply.getInt("replyCode") != 201) {
      throw new ContextException("Bitbucket replied " + reply.getInt("replyCode") + ": "
          + reply.getString("reply"));
    }
    try {
      return new SimpleDataTable(def.getOutputFormat(),
          json.readTree(reply.getString("reply")).path("id").asText());
    } catch (Exception ex) {
      throw new ContextException("Unparseable Bitbucket reply: " + ex.getMessage(), ex);
    }
  }
}
</value></record><record><value name="name">sizeOf</value><value name="description">Changed lines and files of a PR, without excluded files</value><value name="inputformat"><table><formatId id="4"/><records><record><value name="minRecords">1</value><value name="maxRecords">1</value><value name="fields"><table><formatId id="5"/><records><record><value name="name">prId</value><value name="description">PR</value></record></records></table></value><value name="reorderable">0</value><value name="unresizable">1</value></record></records></table></value><value name="outputformat"><table><formatId id="4"/><records><record><value name="minRecords">1</value><value name="maxRecords">1</value><value name="fields"><table><formatId id="5"/><records><record><value name="name">lines</value><value name="description">Changed Lines</value></record><record><value name="name">files</value><value name="description">Changed Files</value></record><record><value name="name">excludedFiles</value><value name="description">Excluded Files</value></record></records></table></value><value name="reorderable">0</value><value name="unresizable">1</value></record></records></table></value><value name="group">prReviewer</value><value name="permissions">admin</value><value name="type">0</value><value name="implementation">import com.tibbo.aggregate.common.context.*;
import com.tibbo.aggregate.common.datatable.*;
import com.tibbo.aggregate.common.server.*;

import com.tibbo.linkserver.*;
import com.tibbo.linkserver.context.*;

import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;

import java.util.regex.Pattern;

/**
 * Measures a pull request from its Bitbucket diffstat: changed lines (added plus removed) and
 * changed files, leaving out the files that match the configured exclusion pattern, such as
 * lock files and generated sources.
 *
 * @author Alexander Sidorov
 *     &lt;p>(co-authored with Claude Opus 5.5)
 */
public class %ScriptClassNamePattern% implements FunctionImplementation {
  private static final String BITBUCKET = "users.admin.devices.bitbucket";
  private static final String API = "https://api.bitbucket.org";
  private static final int MAX_PAGES = 20;

  public DataTable execute(Context con, FunctionDefinition def, CallerController caller,
      RequestController request, DataTable parameters) throws ContextException {
    int id = parameters.rec().getInt("prId");
    DataRecord cfg = con.getVariable("config", caller).rec();
    String exclude = cfg.getString("sizeExcludeRegex");
    Pattern excluded = Pattern.compile(exclude == null || exclude.isEmpty() ? "(?!)" : exclude);
    String next = "/2.0/repositories/" + cfg.getString("workspace") + "/" + cfg.getString("repo")
        + "/pullrequests/" + id + "/diffstat?pagelen=500&amp;fields=next,values.lines_added,"
        + "values.lines_removed,values.old.path,values.new.path";
    ObjectMapper json = new ObjectMapper();
    int lines = 0;
    int files = 0;
    int skipped = 0;
    int pages = 0;
    while (next != null) {
      if (++pages > MAX_PAGES) {
        throw new ContextException("Diffstat of PR " + id + " exceeded " + MAX_PAGES + " pages");
      }
      DataRecord reply = con.callFunction("request", caller, BITBUCKET, "GET", next, null).rec();
      if (reply.getInt("replyCode") != 200) {
        throw new ContextException("Bitbucket replied " + reply.getInt("replyCode")
            + " for the diffstat of PR " + id + ": " + reply.getString("reply"));
      }
      JsonNode root;
      try {
        root = json.readTree(reply.getString("reply"));
      } catch (Exception ex) {
        throw new ContextException("Unparseable diffstat of PR " + id + ": " + ex.getMessage(), ex);
      }
      for (JsonNode file : root.path("values")) {
        String path = file.path("new").path("path").asText(file.path("old").path("path").asText());
        if (excluded.matcher(path).find()) {
          skipped++;
          continue;
        }
        files++;
        lines += file.path("lines_added").asInt() + file.path("lines_removed").asInt();
      }
      JsonNode link = root.path("next");
      next = link.isTextual() ? link.asText().replace(API, "") : null;
    }
    return new SimpleDataTable(def.getOutputFormat(), lines, files, skipped);
  }
}
</value></record><record><value name="name">requestChanges</value><value name="description">Mark a Bitbucket PR as Changes requested</value><value name="inputformat"><table><formatId id="4"/><records><record><value name="minRecords">1</value><value name="maxRecords">1</value><value name="fields"><table><formatId id="5"/><records><record><value name="name">prId</value><value name="description">PR</value></record></records></table></value><value name="reorderable">0</value><value name="unresizable">1</value></record></records></table></value><value name="outputformat"><table><formatId id="4"/><records><record><value name="minRecords">1</value><value name="maxRecords">1</value><value name="fields"><table><formatId id="5"/><records><record><value name="name">requested</value><value name="type">B</value><value name="description">Requested</value></record></records></table></value><value name="reorderable">0</value><value name="unresizable">1</value></record></records></table></value><value name="group">prReviewer</value><value name="permissions">admin</value><value name="type">0</value><value name="implementation">import com.tibbo.aggregate.common.context.*;
import com.tibbo.aggregate.common.datatable.*;
import com.tibbo.aggregate.common.server.*;

import com.tibbo.linkserver.*;
import com.tibbo.linkserver.context.*;

/**
 * Marks a Bitbucket pull request as "Changes requested" on behalf of the account whose
 * credentials the Bitbucket device holds.
 *
 * @author Alexander Sidorov
 *     &lt;p>(co-authored with Claude Opus 5.5)
 */
public class %ScriptClassNamePattern% implements FunctionImplementation {
  private static final String BITBUCKET = "users.admin.devices.bitbucket";

  public DataTable execute(Context con, FunctionDefinition def, CallerController caller,
      RequestController request, DataTable parameters) throws ContextException {
    int id = parameters.rec().getInt("prId");
    DataRecord cfg = con.getVariable("config", caller).rec();
    DataRecord reply = con.callFunction("request", caller, BITBUCKET, "POST",
        "/2.0/repositories/" + cfg.getString("workspace") + "/" + cfg.getString("repo")
            + "/pullrequests/" + id + "/request-changes", "{}").rec();
    int code = reply.getInt("replyCode");
    if (code != 200 &amp;&amp; code != 201) {
      throw new ContextException("Bitbucket replied " + code + " to request-changes on PR " + id
          + ": " + reply.getString("reply"));
    }
    DataTable result = new SimpleDataTable(def.getOutputFormat(), true);
    result.rec().setValue("requested", true);
    return result;
  }
}
</value></record><record><value name="name">runReview</value><value name="description">Run one Claude Code review as the reviewer user</value><value name="inputformat"><table><formatId id="4"/><records><record><value name="minRecords">1</value><value name="maxRecords">1</value><value name="fields"><table><formatId id="5"/><records><record><value name="name">prId</value><value name="description">PR</value></record><record><value name="name">commit</value><value name="type">S</value><value name="description">Head Commit</value></record><record><value name="name">destination</value><value name="type">S</value><value name="description">Destination Branch</value></record><record><value name="name">system</value><value name="type">S</value><value name="description">System Prompt</value></record><record><value name="name">task</value><value name="type">S</value><value name="description">Task Prompt</value></record></records></table></value><value name="reorderable">0</value><value name="unresizable">1</value></record></records></table></value><value name="outputformat"><table><formatId id="4"/><records><record><value name="minRecords">1</value><value name="maxRecords">1</value><value name="fields"><table><formatId id="5"/><records><record><value name="name">successful</value><value name="type">B</value><value name="description">Successful</value></record><record><value name="name">review</value><value name="type">S</value><value name="description">Review</value><value name="nullable">1</value></record><record><value name="name">modelId</value><value name="type">S</value><value name="description">Model Ids</value><value name="nullable">1</value></record><record><value name="name">inputTokens</value><value name="type">L</value><value name="description">Input Tokens</value><value name="defaultValue">0</value></record><record><value name="name">outputTokens</value><value name="type">L</value><value name="description">Output Tokens</value><value name="defaultValue">0</value></record><record><value name="name">cacheReadTokens</value><value name="type">L</value><value name="description">Cache Read Tokens</value><value name="defaultValue">0</value></record><record><value name="name">cacheCreationTokens</value><value name="type">L</value><value name="description">Cache Write Tokens</value><value name="defaultValue">0</value></record><record><value name="name">thinkingTokens</value><value name="type">L</value><value name="description">Thinking Tokens</value><value name="defaultValue">0</value></record><record><value name="name">costUsd</value><value name="type">E</value><value name="description">Cost, USD</value><value name="defaultValue">0</value></record><record><value name="name">numTurns</value><value name="description">Turns</value><value name="defaultValue">0</value></record><record><value name="name">durationMs</value><value name="type">L</value><value name="description">Duration, ms</value><value name="defaultValue">0</value></record><record><value name="name">apiDurationMs</value><value name="type">L</value><value name="description">API Duration, ms</value><value name="defaultValue">0</value></record><record><value name="name">permissionDenials</value><value name="description">Denied Tool Calls</value><value name="defaultValue">0</value></record><record><value name="name">sessionId</value><value name="type">S</value><value name="description">Session Id</value><value name="nullable">1</value></record><record><value name="name">error</value><value name="type">S</value><value name="description">Error</value><value name="nullable">1</value></record></records></table></value><value name="reorderable">0</value><value name="unresizable">1</value></record></records></table></value><value name="group">prReviewer</value><value name="permissions">admin</value><value name="type">0</value><value name="implementation">import com.tibbo.aggregate.common.context.*;
import com.tibbo.aggregate.common.datatable.*;
import com.tibbo.aggregate.common.server.*;

import com.tibbo.linkserver.*;
import com.tibbo.linkserver.context.*;

import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;

import java.io.ByteArrayOutputStream;
import java.io.InputStream;
import java.io.OutputStream;
import java.nio.charset.StandardCharsets;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.Base64;
import java.util.Comparator;
import java.util.List;
import java.util.Map;
import java.util.concurrent.TimeUnit;

/**
 * Runs one headless Claude Code review through the runner script, as the unprivileged reviewer
 * user, and returns the review text with its exact token usage and the models it ran on. The
 * runner reads the system prompt (base64, first stdin line) and the task prompt (rest of stdin)
 * and prints Claude's JSON result.
 *
 * @author Alexander Sidorov
 *     &lt;p>(co-authored with Claude Opus 5.5)
 */
public class %ScriptClassNamePattern% implements FunctionImplementation {
  private static final int MAX_STDERR = 4000;

  public DataTable execute(Context con, FunctionDefinition def, CallerController caller,
      RequestController request, DataTable parameters) throws ContextException {
    DataRecord in = parameters.rec();
    DataRecord cfg = con.getVariable("config", caller).rec();
    String commit = in.getString("commit");
    String destination = in.getString("destination");
    if (!commit.matches("[0-9a-f]{7,40}")) {
      throw new ContextException("Not a commit hash: " + commit);
    }
    if (!destination.matches("[A-Za-z0-9._/-]+") || destination.contains("..")) {
      throw new ContextException("Unsafe branch name: " + destination);
    }
    List&lt;String> command = Arrays.asList("sudo", "-n", "-u", cfg.getString("runAsUser"),
        cfg.getString("runnerScript"), String.valueOf(in.getInt("prId")), commit, destination,
        cfg.getString("model"), String.valueOf(cfg.getInt("maxTurns")), cfg.getString("effort"));
    DataTable result = new SimpleDataTable(def.getOutputFormat(), true);
    DataRecord out = result.rec();
    out.setValue("successful", false);
    Process process = null;
    try {
      process = new ProcessBuilder(command).start();
      ByteArrayOutputStream stdout = new ByteArrayOutputStream();
      ByteArrayOutputStream stderr = new ByteArrayOutputStream();
      Thread outReader = drain(process.getInputStream(), stdout);
      Thread errReader = drain(process.getErrorStream(), stderr);
      try (OutputStream stdin = process.getOutputStream()) {
        String system = Base64.getEncoder()
            .encodeToString(in.getString("system").getBytes(StandardCharsets.UTF_8));
        stdin.write((system + System.lineSeparator() + in.getString("task"))
            .getBytes(StandardCharsets.UTF_8));
      }
      if (!process.waitFor(cfg.getInt("timeoutMinutes"), TimeUnit.MINUTES)) {
        out.setValue("error", "Timed out after " + cfg.getInt("timeoutMinutes") + " min");
        return result;
      }
      outReader.join(10000);
      errReader.join(10000);
      JsonNode reply = lastJson(stdout.toString(StandardCharsets.UTF_8));
      if (reply == null) {
        out.setValue("error", "Exit " + process.exitValue() + ", no result: "
            + tail(stderr.toString(StandardCharsets.UTF_8)));
        return result;
      }
      out.setValue("review", reply.path("result").asText(null));
      usage(reply, out);
      out.setValue("costUsd", reply.path("total_cost_usd").asDouble());
      out.setValue("numTurns", reply.path("num_turns").asInt());
      out.setValue("durationMs", reply.path("duration_ms").asLong());
      out.setValue("apiDurationMs", reply.path("duration_api_ms").asLong());
      out.setValue("permissionDenials", reply.path("permission_denials").size());
      out.setValue("sessionId", reply.path("session_id").asText(null));
      boolean ok = process.exitValue() == 0 &amp;&amp; !reply.path("is_error").asBoolean()
          &amp;&amp; "success".equals(reply.path("subtype").asText());
      out.setValue("successful", ok);
      if (!ok) {
        out.setValue("error", "Claude ended with " + reply.path("subtype").asText() + ": "
            + reply.path("result").asText("") + " "
            + tail(stderr.toString(StandardCharsets.UTF_8)));
      }
      return result;
    } catch (InterruptedException ex) {
      Thread.currentThread().interrupt();
      throw new ContextException("Review interrupted", ex);
    } catch (Exception ex) {
      out.setValue("error", ex.getClass().getSimpleName() + ": " + ex.getMessage());
      return result;
    } finally {
      if (process != null &amp;&amp; process.isAlive()) {
        process.descendants().forEach(ProcessHandle::destroy);
        process.destroy();
      }
    }
  }

  /**
   * Fills the token counts from the per-model usage, which covers every model the session
   * called, and names those models by their exact ids, the costliest first. Falls back to the
   * session-level usage when the per-model breakdown is missing.
   */
  private static void usage(JsonNode reply, DataRecord out) {
    JsonNode models = reply.path("modelUsage");
    if (models.size() == 0) {
      JsonNode usage = reply.path("usage");
      out.setValue("inputTokens", usage.path("input_tokens").asLong());
      out.setValue("outputTokens", usage.path("output_tokens").asLong());
      out.setValue("cacheReadTokens", usage.path("cache_read_input_tokens").asLong());
      out.setValue("cacheCreationTokens", usage.path("cache_creation_input_tokens").asLong());
      out.setValue("thinkingTokens",
          usage.path("output_tokens_details").path("thinking_tokens").asLong());
      return;
    }
    long input = 0;
    long output = 0;
    long cacheRead = 0;
    long cacheCreation = 0;
    long thinking = 0;
    List&lt;Map.Entry&lt;String, JsonNode>> byCost = new ArrayList&lt;&gt;();
    models.fields().forEachRemaining(byCost::add);
    byCost.sort(Comparator.comparingDouble(
        (Map.Entry&lt;String, JsonNode> model) -> model.getValue().path("costUSD").asDouble())
        .reversed());
    List&lt;String> ids = new ArrayList&lt;&gt;();
    for (Map.Entry&lt;String, JsonNode> model : byCost) {
      JsonNode use = model.getValue();
      ids.add(model.getKey());
      input += use.path("inputTokens").asLong();
      output += use.path("outputTokens").asLong();
      cacheRead += use.path("cacheReadInputTokens").asLong();
      cacheCreation += use.path("cacheCreationInputTokens").asLong();
      thinking += use.path("thinkingTokens").asLong();
    }
    out.setValue("inputTokens", input);
    out.setValue("outputTokens", output);
    out.setValue("cacheReadTokens", cacheRead);
    out.setValue("cacheCreationTokens", cacheCreation);
    out.setValue("thinkingTokens", thinking);
    out.setValue("modelId", String.join(", ", ids));
  }

  private static Thread drain(InputStream source, ByteArrayOutputStream target) {
    Thread thread = new Thread(() -> {
      try (InputStream stream = source) {
        stream.transferTo(target);
      } catch (Exception ignored) {
        // The process is gone; whatever was read so far is kept.
      }
    }, "pr-review-drain");
    thread.setDaemon(true);
    thread.start();
    return thread;
  }

  private static JsonNode lastJson(String stdout) {
    List&lt;String> lines = stdout.lines().toList();
    for (int i = lines.size() - 1; i >= 0; i--) {
      String line = lines.get(i).trim();
      if (line.startsWith("{")) {
        try {
          return new ObjectMapper().readTree(line);
        } catch (Exception ignored) {
          return null;
        }
      }
    }
    return null;
  }

  private static String tail(String text) {
    return text.length() > MAX_STDERR ? text.substring(text.length() - MAX_STDERR) : text;
  }
}
</value></record><record><value name="name">poll</value><value name="description">One polling cycle: review new bug PRs once per head commit</value><value name="inputformat"><table><formatId id="4"/><records><record><value name="maxRecords">1</value><value name="fields"><table><formatId id="5"/><records><record><value name="name">prId</value><value name="description">Only This PR</value><value name="nullable">1</value></record><record><value name="name">force</value><value name="type">B</value><value name="description">Even If Already Reviewed</value><value name="defaultValue">false</value></record></records></table></value><value name="reorderable">0</value></record></records></table></value><value name="outputformat"><table><formatId id="4"/><records><record><value name="minRecords">1</value><value name="maxRecords">1</value><value name="fields"><table><formatId id="5"/><records><record><value name="name">openPrs</value><value name="description">Open PRs</value></record><record><value name="name">reviewed</value><value name="description">Reviewed</value></record><record><value name="name">skipped</value><value name="description">Skipped</value></record><record><value name="name">failed</value><value name="description">Failed</value></record></records></table></value><value name="reorderable">0</value><value name="unresizable">1</value></record></records></table></value><value name="help">Not concurrent: overlapping calls queue up, so the ledger has a single writer. Without input it runs a normal cycle; with prId it reviews only that PR (see reviewPr).</value><value name="group">prReviewer</value><value name="permissions">admin</value><value name="type">0</value><value contentType="base64" name="implementation"></value><value name="concurrent">0</value></record><record><value name="name">reviewPr</value><value name="description">Review one open PR now, whatever its issue type and size</value><value name="inputformat"><table><formatId id="4"/><records><record><value name="minRecords">1</value><value name="maxRecords">1</value><value name="fields"><table><formatId id="5"/><records><record><value name="name">prId</value><value name="description">PR</value></record><record><value name="name">force</value><value name="type">B</value><value name="description">Even If Already Reviewed</value><value name="defaultValue">false</value></record></records></table></value><value name="reorderable">0</value><value name="unresizable">1</value></record></records></table></value><value name="outputformat"><table><formatId id="4"/><records><record><value name="minRecords">1</value><value name="maxRecords">1</value><value name="fields"><table><formatId id="5"/><records><record><value name="name">prId</value><value name="description">PR</value></record><record><value name="name">commit</value><value name="type">S</value><value name="description">Head Commit</value><value name="nullable">1</value></record><record><value name="name">status</value><value name="type">S</value><value name="description">Status</value><value name="nullable">1</value></record><record><value name="name">commentId</value><value name="type">S</value><value name="description">Comment Id</value><value name="nullable">1</value></record><record><value name="name">error</value><value name="type">S</value><value name="description">Error</value><value name="nullable">1</value></record></records></table></value><value name="reorderable">0</value><value name="unresizable">1</value></record></records></table></value><value name="help">Waits for any running cycle, then reviews the PR and posts like poll does. A commit already reviewed (DONE or DRY_RUN) is refused unless force is true.</value><value name="group">prReviewer</value><value name="permissions">admin</value><value name="type">0</value><value name="implementation">import com.tibbo.aggregate.common.context.*;
import com.tibbo.aggregate.common.datatable.*;
import com.tibbo.aggregate.common.server.*;

import com.tibbo.linkserver.*;
import com.tibbo.linkserver.context.*;

import java.util.Date;

/**
 * Reviews one open pull request on request, whatever its Jira issue type and size, and returns
 * its ledger row. The review runs inside poll, so the ledger keeps a single writer; a commit that
 * was already reviewed is refused unless force is set.
 *
 * @author Alexander Sidorov
 *     &lt;p>(co-authored with Claude Opus 5.5)
 */
public class %ScriptClassNamePattern% implements FunctionImplementation {
  public DataTable execute(Context con, FunctionDefinition def, CallerController caller,
      RequestController request, DataTable parameters) throws ContextException {
    DataRecord in = parameters.rec();
    int id = in.getInt("prId");
    if (id &lt;= 0) {
      throw new ContextException("Not a pull request id: " + id);
    }
    con.callFunction("poll", caller, id, Boolean.TRUE.equals(in.getBoolean("force")));
    DataRecord latest = null;
    for (DataRecord row : con.getVariable("ledger", caller)) {
      Date started = row.getDate("startedAt");
      if (row.getInt("prId") == id &amp;&amp; started != null
          &amp;&amp; (latest == null || started.after(latest.getDate("startedAt")))) {
        latest = row;
      }
    }
    if (latest == null) {
      throw new ContextException("No review of PR " + id + " was recorded");
    }
    return new SimpleDataTable(def.getOutputFormat(), id, latest.getString("commit"),
        latest.getString("status"), latest.getString("commentId"), latest.getString("error"));
  }
}
</value></record><record><value name="name">usageHistory</value><value name="description">Reviews of a period with token usage and cost</value><value name="inputformat"><table><formatId id="4"/><records><record><value name="minRecords">1</value><value name="maxRecords">1</value><value name="fields"><table><formatId id="5"/><records><record><value name="name">fromDate</value><value name="type">D</value><value name="description">From</value></record><record><value name="name">toDate</value><value name="type">D</value><value name="description">To</value></record></records></table></value><value name="reorderable">0</value><value name="unresizable">1</value></record></records></table></value><value name="outputformat"><table><formatId id="4"/><records><record><value name="fields"><table><formatId id="5"/><records><record><value name="name">time</value><value name="type">D</value><value name="description">Time</value></record><record><value name="name">prId</value><value name="description">PR</value></record><record><value name="name">jiraKey</value><value name="type">S</value><value name="description">Jira Key</value><value name="nullable">1</value></record><record><value name="name">status</value><value name="type">S</value><value name="description">Status</value><value name="nullable">1</value></record><record><value name="name">changesRequested</value><value name="type">B</value><value name="description">Changes Requested</value></record><record><value name="name">model</value><value name="type">S</value><value name="description">Model</value><value name="nullable">1</value></record><record><value name="name">modelId</value><value name="type">S</value><value name="description">Model Ids</value><value name="nullable">1</value></record><record><value name="name">effort</value><value name="type">S</value><value name="description">Effort</value><value name="nullable">1</value></record><record><value name="name">linesChanged</value><value name="description">Changed Lines</value></record><record><value name="name">filesChanged</value><value name="description">Changed Files</value></record><record><value name="name">inputTokens</value><value name="type">L</value><value name="description">Input Tokens</value></record><record><value name="name">outputTokens</value><value name="type">L</value><value name="description">Output Tokens</value></record><record><value name="name">thinkingTokens</value><value name="type">L</value><value name="description">Thinking Tokens</value></record><record><value name="name">cacheReadTokens</value><value name="type">L</value><value name="description">Cache Read Tokens</value></record><record><value name="name">cacheCreationTokens</value><value name="type">L</value><value name="description">Cache Write Tokens</value></record><record><value name="name">totalTokens</value><value name="type">L</value><value name="description">Total Tokens</value></record><record><value name="name">costUsd</value><value name="type">E</value><value name="description">Cost, USD</value></record><record><value name="name">costPer100Lines</value><value name="type">E</value><value name="description">Cost per 100 Lines, USD</value></record><record><value name="name">numTurns</value><value name="description">Turns</value></record><record><value name="name">durationSec</value><value name="type">E</value><value name="description">Duration, s</value></record></records></table></value><value name="reorderable">0</value></record></records></table></value><value name="group">prReviewer</value><value name="permissions">observer</value><value name="type">0</value><value name="implementation">import com.tibbo.aggregate.common.context.*;
import com.tibbo.aggregate.common.datatable.*;
import com.tibbo.aggregate.common.server.*;

import com.tibbo.linkserver.*;
import com.tibbo.linkserver.context.*;

import java.util.Date;

/**
 * Lists the reviews of a period, oldest first, with their token usage, cost and PR size, as
 * recorded by the reviewCompleted event history. Fields that older events lack read as zero or
 * empty.
 *
 * @author Alexander Sidorov
 *     &lt;p>(co-authored with Claude Opus 5.5)
 */
public class %ScriptClassNamePattern% implements FunctionImplementation {
  private static final int MAX_EVENTS = 100000;

  public DataTable execute(Context con, FunctionDefinition def, CallerController caller,
      RequestController request, DataTable parameters) throws ContextException {
    DataRecord in = parameters.rec();
    Date from = in.getDate("fromDate");
    Date to = in.getDate("toDate");
    if (from == null || to == null || from.after(to)) {
      throw new ContextException("Expected a period with fromDate not after toDate");
    }
    Context events = con.getContextManager().get("events", caller);
    DataTable query =
        new SimpleDataTable(events.getFunctionDefinition("get", caller).getInputFormat());
    query.addRecord().setValue("mask", con.getPath()).setValue("event", "reviewCompleted")
        .setValue("fromDate", from).setValue("toDate", to).setValue("dataAsTable", false)
        .setValue("sortField", "creationtime").setValue("sortOrder", true)
        .setValue("limit", MAX_EVENTS);
    DataTable result = new SimpleDataTable(def.getOutputFormat());
    for (DataRecord review : events.callFunction("get", caller, query)) {
      long input = count(review, "inputTokens");
      long output = count(review, "outputTokens");
      long cacheRead = count(review, "cacheReadTokens");
      long cacheCreation = count(review, "cacheCreationTokens");
      long lines = count(review, "linesChanged");
      double cost = review.getDouble("costUsd");
      result.addRecord(review.getDate("eCreationtime"), review.getInt("prId"),
          text(review, "jiraKey"), text(review, "status"), flag(review, "changesRequested"),
          text(review, "model"),
          text(review, "modelId"), text(review, "effort"), (int) lines,
          (int) count(review, "filesChanged"), input, output, count(review, "thinkingTokens"),
          cacheRead, cacheCreation, input + output + cacheRead + cacheCreation, cost,
          lines == 0 ? 0.0 : cost * 100 / lines, (int) count(review, "numTurns"),
          count(review, "durationMs") / 1000.0);
    }
    return result;
  }

  private static long count(DataRecord review, String field) {
    if (!review.getFormat().hasField(field)) {
      return 0;
    }
    Object value = review.getValue(field);
    return value instanceof Number ? ((Number) value).longValue() : 0;
  }

  private static boolean flag(DataRecord review, String field) {
    return review.getFormat().hasField(field) &amp;&amp; Boolean.TRUE.equals(review.getValue(field));
  }

  private static String text(DataRecord review, String field) {
    return review.getFormat().hasField(field) ? review.getString(field) : null;
  }
}
</value></record><record><value name="name">usageByDay</value><value name="description">Daily review cost or tokens as chart rows</value><value name="inputformat"><table><formatId id="4"/><records><record><value name="minRecords">1</value><value name="maxRecords">1</value><value name="fields"><table><formatId id="5"/><records><record><value name="name">fromDate</value><value name="type">D</value><value name="description">From</value></record><record><value name="name">toDate</value><value name="type">D</value><value name="description">To</value></record><record><value name="name">metric</value><value name="type">S</value><value name="description">Metric</value></record></records></table></value><value name="reorderable">0</value><value name="unresizable">1</value></record></records></table></value><value name="outputformat"><table><formatId id="4"/><records><record><value name="fields"><table><formatId id="5"/><records><record><value name="name">series</value><value name="type">S</value><value name="description">Series</value></record><record><value name="name">category</value><value name="type">S</value><value name="description">Day</value></record><record><value name="name">value</value><value name="type">E</value><value name="description">Value</value></record><record><value name="name">group</value><value name="type">S</value><value name="description">Group</value><value name="nullable">1</value></record></records></table></value><value name="reorderable">0</value></record></records></table></value><value name="help">metric: cost or tokens</value><value name="group">prReviewer</value><value name="permissions">observer</value><value name="type">0</value><value name="implementation">import com.tibbo.aggregate.common.context.*;
import com.tibbo.aggregate.common.datatable.*;
import com.tibbo.aggregate.common.server.*;

import com.tibbo.linkserver.*;
import com.tibbo.linkserver.context.*;

import java.time.LocalDate;
import java.time.ZoneId;
import java.util.Date;
import java.util.LinkedHashMap;
import java.util.Map;

/**
 * Sums the review usage of a period per server-local day, as chart rows (series, category,
 * value). Metric "cost" gives one series in USD; "tokens" gives one series per token kind.
 * Days without reviews are present with zeros, so the bars keep an even time scale.
 *
 * @author Alexander Sidorov
 *     &lt;p>(co-authored with Claude Opus 5.5)
 */
public class %ScriptClassNamePattern% implements FunctionImplementation {
  private static final int MAX_DAYS = 400;
  private static final String[][] TOKENS = {
    {"inputTokens", "Input"},
    {"outputTokens", "Output"},
    {"cacheReadTokens", "Cache read"},
    {"cacheCreationTokens", "Cache write"}
  };

  public DataTable execute(Context con, FunctionDefinition def, CallerController caller,
      RequestController request, DataTable parameters) throws ContextException {
    DataRecord in = parameters.rec();
    Date from = in.getDate("fromDate");
    Date to = in.getDate("toDate");
    String metric = in.getString("metric");
    boolean cost = "cost".equals(metric);
    if (!cost &amp;&amp; !"tokens".equals(metric)) {
      throw new ContextException("Metric must be cost or tokens, not " + metric);
    }
    ZoneId zone = ZoneId.systemDefault();
    LocalDate first = from.toInstant().atZone(zone).toLocalDate();
    LocalDate last = to.toInstant().atZone(zone).toLocalDate();
    if (first.plusDays(MAX_DAYS).isBefore(last)) {
      throw new ContextException("Period longer than " + MAX_DAYS + " days");
    }
    Map&lt;LocalDate, double[]&gt; days = new LinkedHashMap&lt;&gt;();
    for (LocalDate day = first; !day.isAfter(last); day = day.plusDays(1)) {
      days.put(day, new double[TOKENS.length + 1]);
    }
    for (DataRecord review : con.callFunction("usageHistory", caller, from, to)) {
      double[] sums =
          days.get(review.getDate("time").toInstant().atZone(zone).toLocalDate());
      if (sums == null) {
        continue;
      }
      sums[TOKENS.length] += review.getDouble("costUsd");
      for (int i = 0; i &lt; TOKENS.length; i++) {
        sums[i] += review.getLong(TOKENS[i][0]);
      }
    }
    DataTable result = new SimpleDataTable(def.getOutputFormat());
    for (Map.Entry&lt;LocalDate, double[]&gt; day : days.entrySet()) {
      String category = day.getKey().toString();
      if (cost) {
        result.addRecord("Cost, USD", category, day.getValue()[TOKENS.length], null);
      } else {
        for (int i = 0; i &lt; TOKENS.length; i++) {
          result.addRecord(TOKENS[i][1], category, day.getValue()[i], null);
        }
      }
    }
    return result;
  }
}
</value></record><record><value name="name">usageSummary</value><value name="description">Review count, tokens and cost of a period</value><value name="inputformat"><table><formatId id="4"/><records><record><value name="minRecords">1</value><value name="maxRecords">1</value><value name="fields"><table><formatId id="5"/><records><record><value name="name">fromDate</value><value name="type">D</value><value name="description">From</value></record><record><value name="name">toDate</value><value name="type">D</value><value name="description">To</value></record></records></table></value><value name="reorderable">0</value><value name="unresizable">1</value></record></records></table></value><value name="outputformat"><table><formatId id="4"/><records><record><value name="minRecords">1</value><value name="maxRecords">1</value><value name="fields"><table><formatId id="5"/><records><record><value name="name">reviews</value><value name="description">Reviews</value></record><record><value name="name">failed</value><value name="description">Failed</value></record><record><value name="name">tokens</value><value name="type">L</value><value name="description">Tokens</value></record><record><value name="name">outputTokens</value><value name="type">L</value><value name="description">Output Tokens</value></record><record><value name="name">costUsd</value><value name="type">E</value><value name="description">Cost, USD</value></record><record><value name="name">avgCostUsd</value><value name="type">E</value><value name="description">Average Cost, USD</value></record><record><value name="name">linesChanged</value><value name="type">L</value><value name="description">Changed Lines</value></record><record><value name="name">costPer100Lines</value><value name="type">E</value><value name="description">Cost per 100 Lines, USD</value></record></records></table></value><value name="reorderable">0</value><value name="unresizable">1</value></record></records></table></value><value name="group">prReviewer</value><value name="permissions">observer</value><value name="type">0</value><value name="implementation">import com.tibbo.aggregate.common.context.*;
import com.tibbo.aggregate.common.datatable.*;
import com.tibbo.aggregate.common.server.*;

import com.tibbo.linkserver.*;
import com.tibbo.linkserver.context.*;

import java.util.Date;

/**
 * Totals of the reviews of a period: count, failures, tokens, cost, and cost per 100 changed
 * lines over the reviews whose PR size is known.
 *
 * @author Alexander Sidorov
 *     &lt;p>(co-authored with Claude Opus 5.5)
 */
public class %ScriptClassNamePattern% implements FunctionImplementation {
  public DataTable execute(Context con, FunctionDefinition def, CallerController caller,
      RequestController request, DataTable parameters) throws ContextException {
    DataRecord in = parameters.rec();
    Date from = in.getDate("fromDate");
    Date to = in.getDate("toDate");
    int reviews = 0;
    int failed = 0;
    long tokens = 0;
    long output = 0;
    long lines = 0;
    double cost = 0;
    double sizedCost = 0;
    for (DataRecord review : con.callFunction("usageHistory", caller, from, to)) {
      reviews++;
      if ("FAILED".equals(review.getString("status"))) {
        failed++;
      }
      tokens += review.getLong("totalTokens");
      output += review.getLong("outputTokens");
      cost += review.getDouble("costUsd");
      if (review.getInt("linesChanged") > 0) {
        lines += review.getInt("linesChanged");
        sizedCost += review.getDouble("costUsd");
      }
    }
    return new SimpleDataTable(def.getOutputFormat(), reviews, failed, tokens, output, cost,
        reviews == 0 ? 0.0 : cost / reviews, lines, lines == 0 ? 0.0 : sizedCost * 100 / lines);
  }
}
